@page "/admin/edit-product/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using FreyKicksStore.Models
@using Microsoft.AspNetCore.Components.Forms
@inject FreyKicksStore.Data.ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env

<PageTitle>Edit Product</PageTitle>

@if (product == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="editModel" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="editModel.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="editModel.Description" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Category</label>
                <select class="form-select" @bind="editModel.Category">
                    @foreach (var c in Enum.GetValues(typeof(ProductCategory)).Cast<ProductCategory>())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Gender</label>
                <select class="form-select" @bind="editModel.Gender">
                    @foreach (var g in Enum.GetValues(typeof(Gender)).Cast<Gender>())
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Image URL</label>
                <InputText class="form-control" @bind-Value="editModel.ImageUrl" />
            </div>
            <div class="col-md-12 mb-3">
                <label class="form-label">Product Images</label>
                <InputFile OnChange="HandleSelectedFiles" multiple />
                <div class="mt-2">
                    @if (!string.IsNullOrEmpty(product.ImageUrls))
                    {
                        foreach (var img in (product.ImageUrls ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <img src="@img" class="img-thumbnail me-2" style="height:64px" />
                        }
                    }
                    @foreach (var img in uploadedImages)
                    {
                        <img src="@img" class="img-thumbnail me-2" style="height:64px" />
                    }
                </div>
            </div>
        </div>

        <h5>Variants</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Size</th>
                    <th>Color</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in variantEditModels)
                {
                    <tr>
                        <td><InputText class="form-control" @bind-Value="v.Sku" /></td>
                        <td>
                            <select class="form-select" @bind="v.Size">
                                @foreach (var s in AllSizes)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </td>
                        <td><InputText class="form-control" @bind-Value="v.Color" /></td>
                        <td><InputNumber class="form-control" @bind-Value="v.Price" /></td>
                        <td><InputNumber class="form-control" @bind-Value="v.Stock" /></td>
                        <td>
                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveVariant(v)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <hr />
        <h6>Generate New Variants</h6>
        <p class="text-muted small">Pick colors and sizes, then Generate — every combination not already listed above gets added automatically with an auto-filled SKU you can still edit.</p>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Colors (comma-separated)</label>
                <input class="form-control" @bind="colorsInput" placeholder="e.g. Black, White, Red" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Sizes</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var s in AllSizes)
                    {
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="checkbox" id="size-@s"
                                   checked="@selectedSizes.Contains(s)"
                                   @onchange="e => ToggleSize(s, (bool)e.Value!)" />
                            <label class="form-check-label" for="size-@s">@s</label>
                        </div>
                    }
                </div>
            </div>
        </div>
        <button type="button" class="btn btn-outline-secondary mb-3" @onclick="GenerateVariants">Generate Variants</button>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="alert alert-info mt-3">@Message</div>
        }

        <div>
            <button class="btn btn-primary" type="submit">Save Changes</button>
            <a class="btn btn-secondary ms-2" href="/admin/inventory">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;

    private ProductEditModel editModel = new();
    private List<VariantEditModel> variantEditModels = new();
    private string? Message;

    private string colorsInput = string.Empty;
    private HashSet<string> selectedSizes = new();
    private static readonly List<string> AllSizes = Enumerable.Range(37, 12).Select(i => i.ToString()).ToList();

    protected override async Task OnInitializedAsync()
    {
        product = await DbContext.Products.Include(p => p.Variants).FirstOrDefaultAsync(p => p.Id == Id);
        if (product == null) return;

        editModel = new ProductEditModel
        {
            Name = product.Name,
            Description = product.Description,
            Category = product.Category,
            Gender = product.Gender,
            ImageUrl = product.ImageUrl
        };

        variantEditModels = product.Variants.Select(v => new VariantEditModel
        {
            Id = v.Id,
            Sku = v.Sku,
            Size = v.Size,
            Color = v.Color,
            Price = v.Price,
            Stock = v.Stock
        }).ToList();
    }

    private void ToggleSize(string size, bool isChecked)
    {
        if (isChecked) selectedSizes.Add(size);
        else selectedSizes.Remove(size);
    }

    private void GenerateVariants()
    {
        var colors = colorsInput.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct()
            .ToList();

        if (!colors.Any() || !selectedSizes.Any())
        {
            Message = "Pick at least one color and one size before generating.";
            return;
        }

        Message = null;
        var existingCombos = variantEditModels
            .Select(v => (Size: v.Size ?? "", Color: (v.Color ?? "").Trim().ToLowerInvariant()))
            .ToHashSet();

        int added = 0;
        foreach (var color in colors)
        {
            foreach (var size in selectedSizes.OrderBy(s => int.Parse(s)))
            {
                var combo = (Size: size, Color: color.Trim().ToLowerInvariant());
                if (existingCombos.Contains(combo)) continue; // already have this size/color for this product

                variantEditModels.Add(new VariantEditModel
                {
                    Id = 0,
                    Sku = GenerateSku(editModel.Name, editModel.Category, size, color),
                    Size = size,
                    Color = color,
                    Price = 0,
                    Stock = 0
                });
                added++;
            }
        }

        Message = added > 0 ? $"Added {added} new variant(s) below. Set their price/stock before saving." : "All those combinations already exist for this product.";
    }

        private static string GenerateSku(string name, ProductCategory category, string size, string color)
    {
        var catCode = category switch
        {
            ProductCategory.Sneakers => "SNK",
            ProductCategory.Corporate => "COR",
            ProductCategory.Slides => "SLD",
            ProductCategory.Canvas => "CAN",
            ProductCategory.Loafers => "LOA",
            _ => "GEN"
        };

        var nameSlug = BuildAcronym(name, 3);

        var colorCode = new string(color.Where(char.IsLetter).ToArray()).ToUpperInvariant();
        colorCode = colorCode.Length >= 3 ? colorCode.Substring(0, 3) : colorCode.PadRight(3, 'X');

        return $"FK-{catCode}-{nameSlug}-{size}-{colorCode}";
    }

    private static string BuildAcronym(string name, int targetLength)
    {
        var words = (name ?? string.Empty)
            .Split(new[] { ' ', '-', '_' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(w => w.Any(char.IsLetter))
            .ToList();
    
        var acronym = new string(words
            .Select(w => w.First(char.IsLetter))
            .ToArray())
            .ToUpperInvariant();
    
        return acronym.Length >= targetLength
            ? acronym.Substring(0, targetLength)
            : acronym.PadRight(targetLength, 'X');
    }

    // Image upload support
    private List<string> uploadedImages = new();
    private readonly string[] allowedContentTypes = new[] { "image/jpeg", "image/png", "image/webp" };
    private const long MaxFileSize = 5 * 1024 * 1024; // 5MB

    private async Task HandleSelectedFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            if (!allowedContentTypes.Contains(file.ContentType)) continue;
            if (file.Size > MaxFileSize) continue;

            var uploads = Path.Combine(Env.WebRootPath, "images", "products");
            if (!Directory.Exists(uploads)) Directory.CreateDirectory(uploads);

            var ext = Path.GetExtension(file.Name);
            var fileName = $"{Guid.NewGuid()}{ext}";
            var savePath = Path.Combine(uploads, fileName);

            await using var stream = file.OpenReadStream(MaxFileSize);
            await using var fs = File.Create(savePath);
            await stream.CopyToAsync(fs);

            var relative = $"/images/products/{fileName}";
            uploadedImages.Add(relative);
        }
    }

    private void RemoveVariant(VariantEditModel v)
    {
        variantEditModels.Remove(v);
    }

    private async Task Save()
    {
        if (product == null) return;

        Message = null;

        if (!variantEditModels.Any())
        {
            Message = "A product needs at least one variant.";
            return;
        }

        foreach (var v in variantEditModels)
        {
            if (string.IsNullOrWhiteSpace(v.Sku) || string.IsNullOrWhiteSpace(v.Size) || string.IsNullOrWhiteSpace(v.Color))
            {
                Message = "Every variant needs a SKU, size, and color.";
                return;
            }
            if (v.Price <= 0)
            {
                Message = $"Variant {v.Sku} needs a price greater than 0.";
                return;
            }
            if (v.Stock < 0)
            {
                Message = $"Variant {v.Sku} has an invalid stock value.";
                return;
            }
        }

        var skus = variantEditModels.Select(v => v.Sku!).ToList();
        var dupesInBatch = skus.GroupBy(s => s).Where(g => g.Count() > 1).Select(g => g.Key).ToList();
        if (dupesInBatch.Any())
        {
            Message = $"Duplicate SKU(s) in this list: {string.Join(", ", dupesInBatch)}. Edit them to be unique.";
            return;
        }

        // Exclude this product's own current variant IDs — editing a variant without
        // changing its SKU shouldn't flag itself as a "duplicate".
        var ownVariantIds = variantEditModels.Where(v => v.Id > 0).Select(v => v.Id).ToHashSet();
        var conflicts = await DbContext.ProductVariants
            .Where(pv => skus.Contains(pv.Sku) && !ownVariantIds.Contains(pv.Id))
            .Select(pv => pv.Sku)
            .ToListAsync();
        if (conflicts.Any())
        {
            Message = $"These SKUs already exist elsewhere: {string.Join(", ", conflicts)}. Edit them to be unique.";
            return;
        }

        product.Name = editModel.Name;
        product.Description = editModel.Description;
        product.Category = editModel.Category;
        product.Gender = editModel.Gender;
        product.ImageUrl = editModel.ImageUrl;

        var keepIds = new List<int>();
        foreach (var ve in variantEditModels)
        {
            if (ve.Id > 0)
            {
                var existing = product.Variants.FirstOrDefault(x => x.Id == ve.Id);
                if (existing != null)
                {
                    existing.Sku = ve.Sku ?? string.Empty;
                    existing.Size = ve.Size;
                    existing.Color = ve.Color;
                    existing.Price = ve.Price;
                    existing.Stock = ve.Stock;
                    keepIds.Add(existing.Id);
                }
            }
            else
            {
                var nv = new ProductVariant
                {
                    Sku = ve.Sku ?? string.Empty,
                    Size = ve.Size,
                    Color = ve.Color,
                    Price = ve.Price,
                    Stock = ve.Stock
                };
                product.Variants.Add(nv);
            }
        }

        var toRemove = product.Variants.Where(v => v.Id > 0 && !keepIds.Contains(v.Id)).ToList();
        if (toRemove.Any())
        {
            DbContext.ProductVariants.RemoveRange(toRemove);
            foreach (var r in toRemove) product.Variants.Remove(r);
        }

        var existingImages = (product.ImageUrls ?? string.Empty).Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
        if (uploadedImages.Any())
        {
            existingImages.AddRange(uploadedImages);
            product.ImageUrls = string.Join(',', existingImages);
        }

        DbContext.Products.Update(product);
        await DbContext.SaveChangesAsync();

        NavigationManager.NavigateTo("/admin/inventory");
    }

    private class ProductEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public ProductCategory Category { get; set; }
        public Gender Gender { get; set; }
        public string? ImageUrl { get; set; }
    }

    private class VariantEditModel
    {
        public int Id { get; set; }
        public string? Sku { get; set; }
        public string? Size { get; set; }
        public string? Color { get; set; }
        public decimal Price { get; set; }
        public int Stock { get; set; }
    }
}
