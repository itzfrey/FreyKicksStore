@page "/admin/edit-product/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using FreyKicksStore.Models
@using Microsoft.AspNetCore.Components.Forms
@inject FreyKicksStore.Data.ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env

<PageTitle>Edit Product</PageTitle>

@if (product == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="editModel" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="editModel.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="editModel.Description" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Category</label>
                <select class="form-select" @bind="editModel.Category">
                    @foreach (var c in Enum.GetValues(typeof(ProductCategory)).Cast<ProductCategory>())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Gender</label>
                <select class="form-select" @bind="editModel.Gender">
                    @foreach (var g in Enum.GetValues(typeof(Gender)).Cast<Gender>())
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Image URL</label>
                <InputText class="form-control" @bind-Value="editModel.ImageUrl" />
            </div>
            <div class="col-md-12 mb-3">
                <label class="form-label">Product Images</label>
                <InputFile OnChange="HandleSelectedFiles" multiple />
                <div class="mt-2">
                    @if (!string.IsNullOrEmpty(product.ImageUrls))
                    {
                        foreach (var img in (product.ImageUrls ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <img src="@img" class="img-thumbnail me-2" style="height:64px" />
                        }
                    }
                    @foreach (var img in uploadedImages)
                    {
                        <img src="@img" class="img-thumbnail me-2" style="height:64px" />
                    }
                </div>
            </div>
        </div>

        <h5>Variants</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Size</th>
                    <th>Color</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in variantEditModels)
                {
                    <tr>
                        <td><InputText class="form-control" @bind-Value="v.Sku" /></td>
                        <td>
                            <select class="form-select" @bind="v.Size">
                                @foreach (var s in sizes)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </td>
                        <td><InputText class="form-control" @bind-Value="v.Color" /></td>
                        <td><InputNumber class="form-control" @bind-Value="v.Price" /></td>
                        <td><InputNumber class="form-control" @bind-Value="v.Stock" /></td>
                        <td>
                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveVariant(v)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h6>Add Variant</h6>
        <div class="row g-2 mb-3">
                <div class="col-md-2">
                <InputText class="form-control" placeholder="SKU" @bind-Value="newVariant.Sku" />
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="newVariant.Size">
                    @foreach (var s in sizes)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <InputText class="form-control" placeholder="Color" @bind-Value="newVariant.Color" />
            </div>
            <div class="col-md-2">
                <InputNumber class="form-control" placeholder="Price" @bind-Value="newVariant.Price" />
            </div>
            <div class="col-md-2">
                <InputNumber class="form-control" placeholder="Stock" @bind-Value="newVariant.Stock" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-secondary w-100" type="button" @onclick="AddNewVariant">Add</button>
            </div>
        </div>

        <button class="btn btn-primary" type="submit">Save Changes</button>
        <a class="btn btn-secondary ms-2" href="/admin/inventory">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;

    private ProductEditModel editModel = new();
    private List<VariantEditModel> variantEditModels = new();

    private VariantEditModel newVariant = new();

    protected override async Task OnInitializedAsync()
    {
        product = await DbContext.Products.Include(p => p.Variants).FirstOrDefaultAsync(p => p.Id == Id);
        if (product == null) return;

        editModel = new ProductEditModel
        {
            Name = product.Name,
            Description = product.Description,
            Category = product.Category,
            Gender = product.Gender,
            ImageUrl = product.ImageUrl
        };

        variantEditModels = product.Variants.Select(v => new VariantEditModel
        {
            Id = v.Id,
            Sku = v.Sku,
            Size = v.Size,
            Color = v.Color,
            Price = v.Price,
            Stock = v.Stock
        }).ToList();
    }

    private void AddNewVariant()
    {
        // simple validation
        if (string.IsNullOrWhiteSpace(newVariant.Sku)) return;

        variantEditModels.Add(new VariantEditModel
        {
            Id = 0,
            Sku = newVariant.Sku,
            Size = newVariant.Size,
            Color = newVariant.Color,
            Price = newVariant.Price,
            Stock = newVariant.Stock
        });

        newVariant = new VariantEditModel();
    }

    // Image upload support
    private List<string> uploadedImages = new();
    private readonly string[] allowedContentTypes = new[] { "image/jpeg", "image/png", "image/webp" };
    private const long MaxFileSize = 5 * 1024 * 1024; // 5MB
    private static readonly IEnumerable<string> sizes = Enumerable.Range(37, 12).Select(i => i.ToString());

    private async Task HandleSelectedFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            if (!allowedContentTypes.Contains(file.ContentType)) continue;
            if (file.Size > MaxFileSize) continue;

            var uploads = Path.Combine(Env.WebRootPath, "images", "products");
            if (!Directory.Exists(uploads)) Directory.CreateDirectory(uploads);

            var ext = Path.GetExtension(file.Name);
            var fileName = $"{Guid.NewGuid()}{ext}";
            var savePath = Path.Combine(uploads, fileName);

            await using var stream = file.OpenReadStream(MaxFileSize);
            await using var fs = File.Create(savePath);
            await stream.CopyToAsync(fs);

            var relative = $"/images/products/{fileName}";
            uploadedImages.Add(relative);
        }
    }

    private void RemoveVariant(VariantEditModel v)
    {
        variantEditModels.Remove(v);
    }

    private async Task Save()
    {
        if (product == null) return;

        product.Name = editModel.Name;
        product.Description = editModel.Description;
        product.Category = editModel.Category;
        product.Gender = editModel.Gender;
        product.ImageUrl = editModel.ImageUrl;

        // Update existing variants and collect ids to keep
        var keepIds = new List<int>();
        foreach (var ve in variantEditModels)
        {
            if (ve.Id > 0)
            {
                var existing = product.Variants.FirstOrDefault(x => x.Id == ve.Id);
                if (existing != null)
                {
                    existing.Sku = ve.Sku ?? string.Empty;
                    existing.Size = ve.Size;
                    existing.Color = ve.Color;
                    existing.Price = ve.Price;
                    existing.Stock = ve.Stock;
                    keepIds.Add(existing.Id);
                }
            }
            else
            {
                // new variant
                var nv = new ProductVariant
                {
                    Sku = ve.Sku ?? string.Empty,
                    Size = ve.Size,
                    Color = ve.Color,
                    Price = ve.Price,
                    Stock = ve.Stock
                };
                product.Variants.Add(nv);
            }
        }

        // Remove variants that were removed in the UI
        var toRemove = product.Variants.Where(v => v.Id > 0 && !keepIds.Contains(v.Id)).ToList();
        if (toRemove.Any())
        {
            DbContext.ProductVariants.RemoveRange(toRemove);
            foreach (var r in toRemove) product.Variants.Remove(r);
        }

        // Merge any uploaded images into ImageUrls
        var existingImages = (product.ImageUrls ?? string.Empty).Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
        if (uploadedImages.Any())
        {
            existingImages.AddRange(uploadedImages);
            product.ImageUrls = string.Join(',', existingImages);
        }

        DbContext.Products.Update(product);
        await DbContext.SaveChangesAsync();

        NavigationManager.NavigateTo("/admin/inventory");
    }

    private class ProductEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public ProductCategory Category { get; set; }
        public Gender Gender { get; set; }
        public string? ImageUrl { get; set; }
    }

    private class VariantEditModel
    {
        public int Id { get; set; }
        public string? Sku { get; set; }
        public string? Size { get; set; }
        public string? Color { get; set; }
        public decimal Price { get; set; }
        public int Stock { get; set; }
    }
}
