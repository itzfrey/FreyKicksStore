@page "/admin"
@layout FreyKicksStore.Components.Layout.AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<h2>Admin Dashboard</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Sales Summary</h5>
                <p class="card-text">(Placeholder) Total sales, revenue, orders.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Low Stock</h5>
                <p class="card-text">(Placeholder) Products low on stock.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Recent Orders</h5>
                <p class="card-text">(Placeholder) Latest orders list.</p>
            </div>
        </div>
    </div>
</div>
