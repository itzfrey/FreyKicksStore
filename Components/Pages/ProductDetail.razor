@page "/product/{Id:int}"
@rendermode InteractiveServer
@using FreyKicksStore.Models
@using Microsoft.EntityFrameworkCore
@inject FreyKicksStore.Data.ApplicationDbContext DbContext
@inject FreyKicksStore.Services.CartService CartService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@(Product?.Name ?? "Product")</PageTitle>

@if (Product is null)
{
    <p>Loading...</p>
}
else
{
    <div class="container py-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/shop?gender=@Product.Gender">@Product.Gender</a></li>
                <li class="breadcrumb-item"><a href="/shop?gender=@Product.Gender&category=@Product.Category">@Product.Category</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Product.Name</li>
            </ol>
        </nav>

        <div class="row g-4">
            <div class="col-lg-6">
                @if (ImageUrls.Count > 0)
                {
                    <div class="mb-3 border rounded overflow-hidden bg-light" style="height:520px; display:flex; align-items:center; justify-content:center;">
                        <img src="@SelectedImage" alt="@Product.Name" style="max-height:100%; max-width:100%; object-fit:contain;" />
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var image in ImageUrls)
                        {
                            <button type="button" class="btn btn-link p-0 border @(SelectedImage == image ? "border-dark" : "border-light")" @onclick="() => SelectedImage = image" style="width:72px; height:72px; overflow:hidden;">
                                <img src="@image" alt="@Product.Name thumbnail" style="width:100%; height:100%; object-fit:cover;" />
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="border rounded bg-light d-flex align-items-center justify-content-center text-muted" style="height:520px;">
                        No image
                    </div>
                }
            </div>

            <div class="col-lg-6">
                <h2 class="mb-3">@Product.Name</h2>
                <p class="h4 mb-3">₦@CurrentPrice.ToString("N2")</p>

                @if (!string.IsNullOrWhiteSpace(Product.Description))
                {
                    <p class="text-secondary mb-4">@Product.Description</p>
                }

                @if (AvailableColors.Count > 0)
                {
                    <div class="mb-4">
                        <div class="fw-semibold mb-2">Color</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var color in AvailableColors)
                            {
                                var isSoldOut = IsColorSoldOut(color);
                                var isSelected = SelectedColor == color;
                                <button type="button"
                                        class="btn btn-sm @(isSelected ? "btn-dark" : isSoldOut ? "btn-outline-secondary soldout-color" : "btn-outline-dark")"
                                        @onclick="() => SelectColor(color)">
                                    <span>@color</span>
                                    @if (isSoldOut)
                                    {
                                        <span class="color-sold-tag">Sold out</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(SelectedColor) && AvailableSizes.Count > 0)
                {
                    <div class="mb-4">
                        <div class="fw-semibold mb-2">Size</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var size in AvailableSizes)
                            {
                                var variant = Product?.Variants.FirstOrDefault(v => v.Color == SelectedColor && v.Size == size);
                                var isSoldOut = variant is null || variant.Stock <= 0;
                                var isSelected = SelectedSize == size;
                                <button type="button"
                                        class="btn btn-sm size-button @(isSelected ? "btn-dark" : "btn-outline-dark") @(isSoldOut ? "soldout-size" : string.Empty)"
                                        disabled="@isSoldOut"
                                        aria-disabled="@(isSoldOut ? "true" : null)"
                                        title="@(isSoldOut ? "Sold out" : null)"
                                        @onclick="() => SelectSize(size)">
                                    @size
                                </button>
                            }
                        </div>

                        @if (SelectedSize is not null && SelectedVariant is not null && SelectedVariant.Stock > 0 && SelectedVariant.Stock <= 5)
                        {
                            <div class="stock-hint">Only @SelectedVariant.Stock left</div>
                        }

                        @if (SelectedColor is not null && IsColorSoldOut(SelectedColor) && SelectedSize is null)
                        {
                            <div class="stock-hint warning">Sold out in this color.</div>
                        }
                    </div>
                }

                @if (SelectedVariant is not null && SelectedVariant.Stock > 0)
                {
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="d-flex align-items-center border rounded quantity-box">
                            <button type="button" class="btn btn-light border-0 quantity-button" @onclick="DecreaseQuantity" disabled="@(Quantity <= 1)" aria-label="Decrease quantity">−</button>
                            <span class="px-3 fw-semibold">@Quantity</span>
                            <button type="button" class="btn btn-light border-0 quantity-button" @onclick="IncreaseQuantity" disabled="@(Quantity >= MaxAddableQuantityForSelectedVariant)" aria-label="Increase quantity">+</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(SelectionMessage))
                {
                    <div class="alert alert-warning py-2 mb-3">@SelectionMessage</div>
                }

                @if (IsProductSoldOut)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-secondary" disabled aria-disabled="true">Sold out</button>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-dark" disabled="@(!CanAddSelectedVariant)" aria-disabled="@(!CanAddSelectedVariant ? "true" : null)" @onclick="AddToCart">Add to Cart</button>
                        <button type="button" class="btn btn-outline-dark" disabled="@(!CanAddSelectedVariant)" aria-disabled="@(!CanAddSelectedVariant ? "true" : null)" @onclick="BuyItNow">Buy It Now</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (ShowToast)
{
    <div class="cart-toast" role="status" aria-live="polite">✓ Added to cart</div>
}

<style>
    .cart-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 2000;
        background: #1f1f1f;
        color: white;
        padding: 0.7rem 1rem;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
        animation: toastFade 2.5s ease forwards;
    }

    .soldout-color {
        opacity: 0.6;
        background: #f8f9fa;
        border-color: #dee2e6;
        color: #6c757d;
    }

    .color-sold-tag {
        display: inline-block;
        margin-left: 0.5rem;
        font-size: 0.7rem;
        border-radius: 999px;
        background: #f1f3f5;
        color: #495057;
        padding: 0.18rem 0.5rem;
        vertical-align: middle;
    }

    .size-button {
        min-width: 54px;
    }

    .soldout-size {
        background: #f3f4f5;
        border-color: #e9ecef;
        color: #adb5bd;
        text-decoration: line-through;
        text-decoration-thickness: 2px;
        text-decoration-color: rgba(108, 117, 125, 0.75);
    }

    .quantity-box {
        min-height: 44px;
    }

    .quantity-button {
        min-width: 44px;
        min-height: 44px;
    }

    .stock-hint {
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: #b42318;
        font-weight: 600;
    }

    .stock-hint.warning {
        color: #b42318;
    }

    @@keyframes toastFade {
        0% { opacity: 0; transform: translateY(-8px); }
        10% { opacity: 1; transform: translateY(0); }
        80% { opacity: 1; }
        100% { opacity: 0; transform: translateY(-6px); }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? Product;
    private List<string> ImageUrls = new();
    private string SelectedImage = string.Empty;
    private string? SelectedColor;
    private string? SelectedSize;
    private ProductVariant? SelectedVariant;
    private int Quantity = 1;
    private bool ShowToast;
    private string? SelectionMessage;

    private bool IsProductSoldOut => Product is not null && Product.Variants.All(v => v.Stock <= 0);

    private bool CanAddSelectedVariant =>
        SelectedVariant is not null &&
        SelectedVariant.Stock > 0 &&
        MaxAddableQuantityForSelectedVariant > 0 &&
        Quantity > 0 &&
        Quantity <= MaxAddableQuantityForSelectedVariant;

    private int MaxAddableQuantityForSelectedVariant
    {
        get
        {
            if (SelectedVariant is null)
            {
                return 0;
            }

            return GetMaxAddableQuantity(SelectedVariant);
        }
    }

    private int GetMaxAddableQuantity(ProductVariant variant)
    {
        if (variant.Stock <= 0)
        {
            return 0;
        }

        var alreadyInCart = CartService.GetItems()
            .Where(item => item.ProductVariantId == variant.Id)
            .Sum(item => item.Quantity);

        return Math.Max(0, variant.Stock - alreadyInCart);
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshProductStateAsync();
    }

    private async Task RefreshProductStateAsync()
    {
        Product = await DbContext.Products
            .Include(p => p.Variants)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (Product is null)
        {
            return;
        }

        ImageUrls = ParseImageUrls(Product.ImageUrls);
        if (ImageUrls.Count > 0)
        {
            SelectedImage = ImageUrls[0];
        }

        ApplyPreferredSelection();
    }

    private void ApplyPreferredSelection()
    {
        if (Product is null)
        {
            return;
        }

        var firstColorWithStock = Product.Variants
            .Where(v => !string.IsNullOrWhiteSpace(v.Color))
            .Select(v => v.Color!)
            .Distinct()
            .FirstOrDefault(color => Product.Variants.Any(v => v.Color == color && v.Stock > 0));

        SelectedColor = string.IsNullOrWhiteSpace(firstColorWithStock)
            ? AvailableColors.FirstOrDefault()
            : firstColorWithStock;

        if (string.IsNullOrWhiteSpace(SelectedColor))
        {
            SelectedSize = null;
            SelectedVariant = null;
            Quantity = 1;
            SelectionMessage = "Sold out in this color.";
            return;
        }

        var firstAvailableSize = Product.Variants
            .Where(v => v.Color == SelectedColor && !string.IsNullOrWhiteSpace(v.Size) && v.Stock > 0)
            .Select(v => v.Size!)
            .Distinct()
            .OrderBy(size => ParseSizeSortKey(size))
            .FirstOrDefault();

        if (string.IsNullOrWhiteSpace(firstAvailableSize))
        {
            SelectedSize = null;
            SelectedVariant = null;
            Quantity = 1;
            SelectionMessage = "Sold out in this color.";
            return;
        }

        SelectedSize = firstAvailableSize;
        SelectedVariant = Product.Variants.First(v => v.Color == SelectedColor && v.Size == SelectedSize && v.Stock > 0);
        Quantity = ClampQuantity();
        SelectionMessage = null;
    }

    private static List<string> ParseImageUrls(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new List<string>();
        }

        return raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(url => !string.IsNullOrWhiteSpace(url))
            .ToList();
    }

    private List<string> AvailableColors =>
        Product is null
            ? new List<string>()
            : Product.Variants
                .Where(v => !string.IsNullOrWhiteSpace(v.Color))
                .Select(v => v.Color!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();

    private List<string> AvailableSizes =>
        string.IsNullOrWhiteSpace(SelectedColor)
            ? new List<string>()
            : AvailableSizesFor(SelectedColor);

    private List<string> AvailableSizesFor(string color)
    {
        if (Product is null)
        {
            return new List<string>();
        }

        return Product.Variants
            .Where(v => v.Color == color && !string.IsNullOrWhiteSpace(v.Size))
            .Select(v => v.Size!)
            .Distinct()
            .OrderBy(size => ParseSizeSortKey(size))
            .ToList();
    }

    private static int ParseSizeSortKey(string? size)
    {
        return int.TryParse(size, out var numeric) ? numeric : int.MaxValue;
    }

    private bool IsColorSoldOut(string color)
    {
        if (Product is null)
        {
            return false;
        }

        return Product.Variants
            .Where(v => v.Color == color)
            .All(v => v.Stock <= 0);
    }

    private int ClampQuantity()
    {
        if (SelectedVariant is null)
        {
            return 1;
        }

        var maxAllowed = GetMaxAddableQuantity(SelectedVariant);
        var effectiveLimit = SelectedVariant.Stock;
        if (maxAllowed > 0)
        {
            effectiveLimit = Math.Min(effectiveLimit, maxAllowed);
        }

        if (effectiveLimit <= 0)
        {
            return 1;
        }

        return Math.Clamp(Quantity, 1, effectiveLimit);
    }

    private void SelectColor(string color)
    {
        SelectedColor = color;
        SelectedSize = null;
        SelectedVariant = null;
        SelectionMessage = null;

        var firstAvailableSize = Product?.Variants
            .Where(v => v.Color == color && !string.IsNullOrWhiteSpace(v.Size) && v.Stock > 0)
            .Select(v => v.Size!)
            .Distinct()
            .OrderBy(size => ParseSizeSortKey(size))
            .FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(firstAvailableSize))
        {
            SelectedSize = firstAvailableSize;
            SelectedVariant = Product?.Variants.FirstOrDefault(v => v.Color == color && v.Size == SelectedSize && v.Stock > 0);
            Quantity = ClampQuantity();
            return;
        }

        SelectionMessage = "Sold out in this color.";
    }

    private void SelectSize(string size)
    {
        SelectedSize = size;
        SelectedVariant = Product?.Variants.FirstOrDefault(v => v.Color == SelectedColor && v.Size == SelectedSize);
        SelectionMessage = null;
        Quantity = ClampQuantity();
    }

    private decimal CurrentPrice =>
        SelectedVariant is not null
            ? SelectedVariant.Price
            : Product?.Variants.Select(v => v.Price).DefaultIfEmpty(0).Min() ?? 0m;

    private void IncreaseQuantity()
    {
        if (SelectedVariant is null)
        {
            return;
        }

        var maxAllowed = GetMaxAddableQuantity(SelectedVariant);
        if (maxAllowed <= 0)
        {
            SelectionMessage = "You already have the maximum available in your cart.";
            return;
        }

        if (Quantity < maxAllowed && Quantity < SelectedVariant.Stock)
        {
            Quantity += 1;
        }

        if (SelectedVariant.Stock > 0 && SelectedVariant.Stock <= 5)
        {
            SelectionMessage = $"Only {SelectedVariant.Stock} left";
        }
        else
        {
            SelectionMessage = null;
        }
    }

    private void DecreaseQuantity()
    {
        if (Quantity > 1)
        {
            Quantity -= 1;
        }

        if (SelectedVariant is not null && SelectedVariant.Stock > 0 && SelectedVariant.Stock <= 5)
        {
            SelectionMessage = $"Only {SelectedVariant.Stock} left";
        }
        else
        {
            SelectionMessage = null;
        }
    }

    private async Task<bool> AddToCart()
    {
        if (SelectedVariant is null)
        {
            SelectionMessage = "Please select a size.";
            return false;
        }

        var freshVariant = await DbContext.ProductVariants
            .AsNoTracking()
            .FirstOrDefaultAsync(v => v.Id == SelectedVariant.Id);

        if (freshVariant is null)
        {
            SelectionMessage = "This size is no longer available.";
            await RefreshProductStateAsync();
            return false;
        }

        var alreadyInCart = CartService.GetItems()
            .Where(item => item.ProductVariantId == freshVariant.Id)
            .Sum(item => item.Quantity);

        if (freshVariant.Stock <= 0)
        {
            SelectionMessage = "This size is sold out.";
            await RefreshProductStateAsync();
            return false;
        }

        var maxAddable = Math.Max(0, freshVariant.Stock - alreadyInCart);
        if (maxAddable <= 0)
        {
            SelectionMessage = "You already have the maximum available in your cart.";
            await RefreshProductStateAsync();
            return false;
        }

        if (Quantity > maxAddable)
        {
            Quantity = maxAddable;
            SelectionMessage = $"Only {maxAddable} left";
            await RefreshProductStateAsync();
            return false;
        }

        CartService.AddToCart(new CartItem
        {
            ProductVariantId = freshVariant.Id,
            Sku = freshVariant.Sku,
            ProductName = Product?.Name ?? string.Empty,
            Price = freshVariant.Price,
            Quantity = Quantity
        });

        try
        {
            var cartItems = CartService.GetItems()
                .Select(item => new CartItem
                {
                    ProductVariantId = item.ProductVariantId,
                    Sku = item.Sku,
                    ProductName = item.ProductName,
                    Price = item.Price,
                    Quantity = item.Quantity
                })
                .ToList();

            var payload = System.Text.Json.JsonSerializer.Serialize(cartItems);
            var encodedPayload = Uri.EscapeDataString(payload);
            await JS.InvokeVoidAsync("eval", $"document.cookie = \"guest_cart={encodedPayload}; path=/; max-age=604800;\";");
        }
        catch (Exception)
        {
            // Ignore cookie write failures and keep the product flow working.
        }

        SelectionMessage = null;
        ShowToast = true;
        await InvokeAsync(StateHasChanged);
        _ = DismissToastAsync();
        return true;
    }

    private async Task BuyItNow()
    {
        var wasAdded = await AddToCart();
        if (wasAdded)
        {
            NavigationManager.NavigateTo("/checkout");
        }
    }

    private async Task DismissToastAsync()
    {
        await Task.Delay(2500);
        ShowToast = false;
        await InvokeAsync(StateHasChanged);
    }
}
