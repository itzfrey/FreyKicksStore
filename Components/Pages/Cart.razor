    .empty-icon {
        width: 88px;
        height: 88px;
        margin: 0 auto 18px;
        border-radius: 50%;
        border: 1px solid rgba(17, 17, 17, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #111;
        background: #f8f9fa;
    }

    .empty-icon svg {
        width: 40px;
        height: 40px;
    }

    .empty-state-card h1 {
        margin: 0 0 8px;
        font-size: clamp(2rem, 2vw + 0.5rem, 2.5rem);
        letter-spacing: -0.04em;
        font-weight: 700;
        color: #111;
    }

    .empty-state-card p {
        margin: 0 0 22px;
        color: #6c757d;
    }

    .start-shopping-btn {
        min-height: 48px;
        padding-inline: 20px;
        border-radius: 12px;
    }

    .mobile-checkout-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-top: 1px solid rgba(17, 17, 17, 0.08);
        padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
        box-shadow: 0 -12px 22px rgba(17, 17, 17, 0.06);
    }

    .mobile-total {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .mobile-total span {
        font-size: 0.72rem;
        color: #6c757d;
    }

    .mobile-total strong {
        font-size: 1.05rem;
        color: #111;
    }

    .mobile-checkout-button {
        flex: 1 1 auto;
        max-width: 200px;
        min-height: 48px;
        border-radius: 12px;
    }

    @@media (max-width: 991.98px) {
        .cart-page {
            padding-top: 16px;
            padding-bottom: 110px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-subtitle {
            font-size: 0.9rem;
        }

        .cart-layout {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .summary-card {
            position: static;
        }

        .item-image-wrap {
            width: 80px;
            height: 80px;
        }

        .item-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .item-price {
            width: 100%;
            text-align: right;
        }

        .item-actions {
            align-items: center;
        }

        .remove-link {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #f8f9fa;
            border: 1px solid rgba(17, 17, 17, 0.05);
            padding: 0;
        }

        .remove-link span {
            display: none;
        }

        .mobile-checkout-bar {
            display: flex;
        }
    }

    @@media (max-width: 575.98px) {
        .cart-item {
            gap: 12px;
            padding: 14px;
        }

        .item-copy {
            width: 100%;
        }

        .quantity-stepper {
            gap: 6px;
            padding: 4px;
        }

        .quantity-btn {
            width: 36px;
            height: 36px;
        }

        .quantity-stepper input {
            width: 42px;
            font-size: 0.9rem;
        }
    }
</style>

@code {
    private List<CartItem> Items = new();
    private List<CartLineItem> LineItems = new();
    private string? AddedSku;
    private int? RemovingItemId;

    private string ItemCountText => $"{Items.Count} item{(Items.Count == 1 ? string.Empty : "s")}";
    private decimal Subtotal => Items.Sum(item => item.Price * item.Quantity);
    private bool HasOutOfStock => LineItems.Any(item => item.IsOutOfStock || (item.Variant is not null && item.CartItem.Quantity > item.Variant.Stock && item.Variant.Stock > 0));

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        AddedSku = query.Get("added");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Items = CartService.GetItems().ToList();
        await RefreshLineItemsAsync();
        await SyncGuestCartCookieAsync();
    }

    private async Task RefreshLineItemsAsync()
    {
        var variantIds = Items.Select(item => item.ProductVariantId).Distinct().ToList();
        var variants = variantIds.Count == 0
            ? new List<ProductVariant>()
            : await DbContext.ProductVariants
                .Include(variant => variant.Product)
                .Where(variant => variantIds.Contains(variant.Id))
                .ToListAsync();

        var lookup = variants.ToDictionary(variant => variant.Id);
        LineItems = Items
            .Select(item =>
            {
                var variant = lookup.TryGetValue(item.ProductVariantId, out var matchedVariant) ? matchedVariant : null;
                var maxStock = variant?.Stock ?? 0;
                var warningText = variant is null || maxStock <= 0
                    ? "Out of stock"
                    : item.Quantity > maxStock
                        ? $"Only {maxStock} left"
                        : null;

                return new CartLineItem
                {
                    CartItem = item,
                    Variant = variant,
                    WarningText = warningText,
                    ImageUrl = ResolveImageUrl(variant),
                    MaxStock = maxStock,
                    IsOutOfStock = variant is null || maxStock <= 0
                };
            })
            .ToList();
    }

    private static string ResolveImageUrl(ProductVariant? variant)
    {
        if (variant?.Product is null)
        {
            return string.Empty;
        }

        var urls = variant.Product.ImageUrls?
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => value.Trim())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToList() ?? new List<string>();

        if (urls.Count > 0)
        {
            return urls[0];
        }

        return string.IsNullOrWhiteSpace(variant.Product.ImageUrl) ? string.Empty : variant.Product.ImageUrl;
    }

    private async Task ChangeQuantityAsync(int cartItemId, int nextQuantity)
    {
        await UpdateQuantityAsync(cartItemId, nextQuantity);
    }

    private async Task UpdateQuantityAsync(int cartItemId, int requestedQuantity)
    {
        var item = CartService.GetItems().SingleOrDefault(existing => existing.Id == cartItemId);
        if (item is null)
        {
            return;
        }

        var variant = await DbContext.ProductVariants
            .AsNoTracking()
            .SingleOrDefaultAsync(variant => variant.Id == item.ProductVariantId);

        var maxStock = variant?.Stock ?? 0;
        var safeQuantity = requestedQuantity;

        if (maxStock > 0)
        {
            safeQuantity = Math.Clamp(safeQuantity, 1, maxStock);
        }
        else
        {
            safeQuantity = Math.Max(1, safeQuantity);
        }

        CartService.UpdateQuantity(cartItemId, safeQuantity);
        await LoadAsync();
    }

    private async Task RemoveAsync(int cartItemId)
    {
        RemovingItemId = cartItemId;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(180);

        CartService.RemoveFromCart(cartItemId);
        RemovingItemId = null;
        await LoadAsync();
    }

    private async Task SyncGuestCartCookieAsync()
    {
        try
        {
            var cartItems = CartService.GetItems()
                .Select(item => new CartItem
                {
                    ProductVariantId = item.ProductVariantId,
                    Sku = item.Sku,
                    ProductName = item.ProductName,
                    Price = item.Price,
                    Quantity = item.Quantity
                })
                .ToList();

            var payload = System.Text.Json.JsonSerializer.Serialize(cartItems);
            var encodedPayload = Uri.EscapeDataString(payload);
            await JS.InvokeVoidAsync("eval", $"document.cookie = \"guest_cart={encodedPayload}; path=/; max-age=604800;\";");
        }
        catch
        {
            // Keep cart behavior intact even if the cookie update fails.
        }
    }

    private static int ParseQuantity(object? value, int fallback)
    {
        return int.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;
    }

    private sealed class CartLineItem
    {
        public CartItem CartItem { get; set; } = new();
        public ProductVariant? Variant { get; set; }
        public string? WarningText { get; set; }
        public string? ImageUrl { get; set; }
        public int MaxStock { get; set; }
        public bool IsOutOfStock { get; set; }
    }
}
