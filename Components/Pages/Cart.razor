        outline: none;
    }

    .checkout-button.disabled,
    .mobile-checkout-button.disabled {
        background: #dfe3e8;
        border-color: #dfe3e8;
        color: #6c757d;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
        pointer-events: none;
    }

    .checkout-button svg,
    .mobile-checkout-button svg {
        width: 18px;
        height: 18px;
    }

    .summary-note {
        margin: 12px 0 0;
        color: #6c757d;
        font-size: 0.78rem;
        line-height: 1.5;
        text-align: center;
    }

    .secondary-link {
        display: inline-block;
        width: 100%;
        margin-top: 12px;
        text-align: center;
        color: #111;
        text-decoration: none;
        font-weight: 600;
    }

    .secondary-link:hover,
    .secondary-link:focus-visible {
        color: #111;
        text-decoration: underline;
        outline: none;
    }

    .empty-state-card {
        max-width: 560px;
        margin: 32px auto 0;
        padding: 40px 28px;
        text-align: center;
