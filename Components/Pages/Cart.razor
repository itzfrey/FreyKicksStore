@page "/cart"
@rendermode InteractiveServer
@using FreyKicksStore.Models
@using Microsoft.EntityFrameworkCore
@inject FreyKicksStore.Services.CartService CartService
@inject FreyKicksStore.Data.ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Cart</PageTitle>

<div class="cart-page">
    @if (!string.IsNullOrEmpty(AddedSku))
    {
        <div class="cart-alert" role="alert" aria-live="polite">
            Added <strong>@AddedSku</strong> to cart.
        </div>
    }

    @if (!Items.Any())
    {
        <div class="empty-state-card">
            <div class="empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3.5 7.5h17l-1.4 11.2a2.1 2.1 0 0 1-2.1 1.8H7a2.1 2.1 0 0 1-2.1-1.8L3.5 7.5Z"/>
                    <path d="M8.5 7.5V6.5A3.5 3.5 0 0 1 12 3a3.5 3.5 0 0 1 3.5 3.5v1"/>
                </svg>
            </div>
            <h1>Your cart is empty</h1>
            <p>Add a few pairs to get started.</p>
            <a class="btn btn-dark start-shopping-btn" href="/shop">Start shopping</a>
        </div>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1 class="page-title">Your cart</h1>
                <p class="page-subtitle" aria-live="polite">@ItemCountText</p>
            </div>
            <a class="continue-link" href="/shop">Continue shopping</a>
        </div>

        <div class="cart-layout">
            <div class="items-column">
                <div class="cart-card">
                    @foreach (var item in LineItems)
                    {
                        var stock = item.MaxStock;
                        var itemTotal = item.CartItem.Price * item.CartItem.Quantity;
                        var productId = item.Variant?.ProductId ?? 0;
                        var productLink = productId > 0 ? $"/product/{productId}" : "/shop";

                        <div class="cart-item @(RemovingItemId == item.CartItem.Id ? "is-removing" : string.Empty)">
                            <div class="item-image-wrap">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.CartItem.ProductName" class="item-image" />
                                }
                                else
                                {
                                    <div class="item-placeholder" aria-label="No product image available">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3.5 7.5h17l-1.4 11.2a2.1 2.1 0 0 1-2.1 1.8H7a2.1 2.1 0 0 1-2.1-1.8L3.5 7.5Z"/>
                                            <path d="M8.5 7.5V6.5A3.5 3.5 0 0 1 12 3a3.5 3.5 0 0 1 3.5 3.5v1"/>
                                        </svg>
                                    </div>
                                }
                            </div>

                            <div class="item-content">
                                <div class="item-header">
                                    <div class="item-copy">
                                        <a href="@productLink" class="item-name">@item.CartItem.ProductName</a>
                                        <p class="item-meta">
                                            @if (item.Variant is not null)
                                            {
                                                <span>Size @item.Variant.Size</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Variant.Color))
                                                {
                                                    <span> • @item.Variant.Color</span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(item.CartItem.Sku))
                                            {
                                                <span>@item.CartItem.Sku</span>
                                            }
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(item.WarningText))
                                        {
                                            <div class="stock-warning">@item.WarningText</div>
                                        }
                                    </div>
                                    <div class="item-price" aria-label="Line total for @item.CartItem.ProductName">₦@itemTotal.ToString("N2")</div>
                                </div>

                                <div class="item-actions">
                                    <div class="quantity-stepper" role="group" aria-label="Quantity selector for @item.CartItem.ProductName">
                                        <button type="button"
                                                class="quantity-btn"
                                                aria-label="Decrease quantity for @item.CartItem.ProductName"
                                                disabled="@(item.CartItem.Quantity <= 1)"
                                                @onclick="() => ChangeQuantityAsync(item.CartItem.Id, item.CartItem.Quantity - 1)">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                        </button>

                                        <input type="number"
                                               value="@item.CartItem.Quantity"
                                               min="1"
                                               max="@(stock > 0 ? stock : 1)"
                                               aria-label="Quantity for @item.CartItem.ProductName"
                                               @onchange="@(async e => await UpdateQuantityAsync(item.CartItem.Id, ParseQuantity(e.Value, item.CartItem.Quantity)))" />

                                        <button type="button"
                                                class="quantity-btn"
                                                aria-label="Increase quantity for @item.CartItem.ProductName"
                                                disabled="@(stock <= 0 || item.CartItem.Quantity >= stock)"
                                                @onclick="() => ChangeQuantityAsync(item.CartItem.Id, item.CartItem.Quantity + 1)">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                        </button>
                                    </div>

                                    <button type="button" class="remove-link" aria-label="Remove @item.CartItem.ProductName from cart" @onclick="() => RemoveAsync(item.CartItem.Id)">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M5 7.5h14M9 7.5V5.8A1.8 1.8 0 0 1 10.8 4h2.4A1.8 1.8 0 0 1 15 5.8v1.7M7.1 7.5l.8 11.2A1.8 1.8 0 0 0 9.7 20h4.6a1.8 1.8 0 0 0 1.8-1.3l.8-11.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <span>Remove</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <aside class="summary-column">
                <div class="summary-card">
                    <h2>Order summary</h2>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <strong aria-live="polite">₦@Subtotal.ToString("N2")</strong>
                    </div>

                    <div class="summary-row muted-row">
                        <span>Shipping</span>
                        <span>Calculated at checkout</span>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-total">
                        <span>Total</span>
                        <strong aria-live="polite">₦@Subtotal.ToString("N2")</strong>
                    </div>

                    <a class="checkout-button @(HasOutOfStock ? "disabled" : string.Empty)"
                       href="@(HasOutOfStock ? null : "/checkout")"
                       aria-disabled="@(HasOutOfStock ? "true" : null)
                       onclick="@(HasOutOfStock ? "return false;" : null)">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 11.5h9.3l-3.2-3.1 1.1-1.1 5.1 5.1-5.1 5.1-1.1-1.1 3.2-3.1H7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Checkout
                    </a>

                    <p class="summary-note">Taxes and shipping are finalized at checkout.</p>
                    <a class="secondary-link" href="/shop">Continue shopping</a>
                </div>
            </aside>
        </div>
    }

    @if (Items.Any())
    {
        <div class="mobile-checkout-bar">
            <div class="mobile-total" aria-live="polite">
                <span>Total</span>
                <strong>₦@Subtotal.ToString("N2")</strong>
            </div>
            <a class="mobile-checkout-button @(HasOutOfStock ? "disabled" : string.Empty)"
               href="@(HasOutOfStock ? null : "/checkout")"
               aria-disabled="@(HasOutOfStock ? "true" : null)"
               onclick="@(HasOutOfStock ? "return false;" : null)">
                Checkout
            </a>
        </div>
    }
</div>

<style>
    body {
        background: #f8f9fa;
    }

    .cart-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 16px 120px;
    }

    .cart-alert {
        background: #eaf7ee;
        color: #205b3f;
        border: 1px solid rgba(32, 91, 63, 0.15);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 18px;
        font-weight: 500;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        font-size: clamp(2rem, 2vw + 1rem, 2.8rem);
        letter-spacing: -0.04em;
        font-weight: 700;
        color: #111;
    }

    .page-subtitle {
        margin: 6px 0 0;
        color: #6c757d;
        font-size: 0.95rem;
    }

    .continue-link {
        color: #111;
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s ease;
    }

    .continue-link:hover,
    .continue-link:focus-visible {
        color: #111;
        opacity: 0.7;
        text-decoration: none;
        outline: none;
    }

    .cart-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.9fr) minmax(280px, 1fr);
        gap: 24px;
        align-items: flex-start;
    }

    .cart-card,
    .summary-card,
    .empty-state-card {
        background: #fff;
        border: 1px solid rgba(17, 17, 17, 0.05);
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(17, 17, 17, 0.04);
    }

    .cart-card {
        padding: 0;
        overflow: hidden;
    }

    .cart-item {
        display: flex;
        gap: 18px;
        padding: 20px;
        border-bottom: 1px solid rgba(17, 17, 17, 0.06);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .cart-item:last-child {
        border-bottom: none;
    }

    .cart-item.is-removing {
        opacity: 0;
        transform: translateX(-8px);
        pointer-events: none;
    }

    .item-image-wrap {
        width: 96px;
        height: 96px;
        border-radius: 12px;
        overflow: hidden;
        background: #f3f4f6;
        border: 1px solid rgba(17, 17, 17, 0.04);
        flex-shrink: 0;
    }

    .item-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .item-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        background: #f8f9fa;
    }

    .item-placeholder svg {
        width: 28px;
        height: 28px;
    }

    .item-content {
        display: flex;
        flex-direction: column;
        gap: 14px;
        width: 100%;
    }

    .item-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .item-copy {
        min-width: 0;
        flex: 1;
    }

    .item-name {
        font-size: 1.05rem;
        line-height: 1.3;
        font-weight: 700;
        color: #111;
        text-decoration: none;
    }

    .item-name:hover,
    .item-name:focus-visible {
        text-decoration: underline;
        color: #111;
        outline: none;
    }

    .item-meta {
        margin: 6px 0 0;
        color: #6c757d;
        font-size: 0.86rem;
        line-height: 1.5;
    }

    .stock-warning {
        margin-top: 8px;
        color: #b42318;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .item-price {
        font-weight: 700;
        font-size: 1.02rem;
        color: #111;
        white-space: nowrap;
    }

    .item-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .quantity-stepper {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        border: 1px solid rgba(17, 17, 17, 0.08);
        background: #f8f9fa;
        padding: 6px;
    }

    .quantity-btn {
        width: 40px;
        height: 40px;
        border: 1px solid transparent;
        background: transparent;
        border-radius: 50%;
        color: #111;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .quantity-btn svg {
        width: 18px;
        height: 18px;
        display: block;
    }

    .quantity-btn:hover:not(:disabled),
    .quantity-btn:focus-visible:not(:disabled) {
        background: #fff;
        border-color: rgba(17, 17, 17, 0.08);
        outline: none;
    }

    .quantity-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    .quantity-stepper input {
        width: 52px;
        border: none;
        background: transparent;
        text-align: center;
        font-weight: 700;
        color: #111;
        padding: 0;
        appearance: textfield;
    }

    .quantity-stepper input:focus {
        outline: none;
    }

    .quantity-stepper input::-webkit-outer-spin-button,
    .quantity-stepper input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .remove-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        background: transparent;
        color: #5a636b;
        font-weight: 600;
        padding: 0;
        transition: color 0.2s ease;
    }

    .remove-link svg {
        width: 16px;
        height: 16px;
    }

    .remove-link:hover,
    .remove-link:focus-visible {
        color: #b42318;
        outline: none;
    }

    .summary-column {
        position: relative;
    }

    .summary-card {
        position: sticky;
        top: 24px;
        padding: 24px;
    }

    .summary-card h2 {
        margin: 0 0 20px;
        font-size: 1.35rem;
        font-weight: 700;
        color: #111;
    }

    .summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-size: 0.98rem;
        color: #212529;
        margin-bottom: 12px;
    }

    .muted-row {
        color: #6c757d;
    }

    .summary-divider {
        height: 1px;
        background: rgba(17, 17, 17, 0.08);
        margin: 18px 0 20px;
    }

    .summary-total {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-size: 1.1rem;
        font-weight: 700;
        color: #111;
        margin-bottom: 16px;
    }

    .checkout-button,
    .mobile-checkout-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 52px;
        border-radius: 12px;
        background: #111;
        color: #fff;
        border: 1px solid #111;
        text-decoration: none;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    }

    .checkout-button:hover,
    .mobile-checkout-button:hover,
    .checkout-button:focus-visible,
    .mobile-checkout-button:focus-visible {
        color: #fff;
        text-decoration: none;
        box-shadow: 0 10px 24px rgba(17, 17, 17, 0.15);
