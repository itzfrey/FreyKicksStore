@page "/"

<PageTitle>Frey Kicks</PageTitle>

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">Frey Kicks</h1>
    <p class="fs-4">Sneakers, corporate shoes, and slides — for everyone.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Sneakers</h5>
                <a class="btn btn-outline-dark mt-2" href="/shop?category=Sneakers">Shop Sneakers</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Corporate</h5>
                <a class="btn btn-outline-dark mt-2" href="/shop?category=Corporate">Shop Corporate</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Slides</h5>
                <a class="btn btn-outline-dark mt-2" href="/shop?category=Slides">Shop Slides</a>
            </div>
        </div>
    </div>
</div>
