@page "/"
@using FreyKicksStore.Models
@using Microsoft.EntityFrameworkCore
@using FreyKicksStore.Components.Shared
@inject FreyKicksStore.Data.ApplicationDbContext DbContext

<PageTitle>Frey Kicks</PageTitle>

<section class="hero">
    <img src="/images/products/freykicks_hero.webp" alt="Featured sneakers" class="hero-bg" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 class="site-logo hero-title">Frey Kicks</h1>
        <p class="hero-subtitle">Sneakers, corporate shoes, and slides — for everyone.</p>
        <a href="/shop" class="btn hero-cta">Shop Now</a>
    </div>
</section>

@if (Bestsellers.Any())
{
    <section class="mb-5">
        <h3 class="mb-3">Bestsellers</h3>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var p in Bestsellers)
            {
                <div class="col"><ProductCard Product="p" /></div>
            }
        </div>
    </section>
}

@if (LatestArrivals.Any())
{
    <section class="mb-5">
        <h3 class="mb-3">Latest Arrivals</h3>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var p in LatestArrivals)
            {
                <div class="col"><ProductCard Product="p" /></div>
            }
        </div>
    </section>
}

@if (Slides.Any())
{
    <section class="mb-5">
        <h3 class="mb-3">Slides</h3>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var p in Slides)
            {
                <div class="col"><ProductCard Product="p" /></div>
            }
        </div>
    </section>
}

@if (RandomSneakers.Any())
{
    <section class="mb-5">
        <h3 class="mb-3">Sneakers You Might Like</h3>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var p in RandomSneakers)
            {
                <div class="col"><ProductCard Product="p" /></div>
            }
        </div>
    </section>
}

<footer class="border-top pt-4 pb-5 mt-5 text-center text-muted">
    <div class="mb-2 fw-bold text-dark">Frey Kicks</div>
    <div class="mb-2">
        <a href="/shop" class="text-muted me-3">Shop</a>
        <a href="/contact" class="text-muted me-3">Contact Us</a>
        <a href="/cart" class="text-muted">Cart</a>
    </div>
    <small>&copy; @DateTime.Now.Year Frey Kicks. All rights reserved.</small>
</footer>

@code {
    private List<Product> Bestsellers = new();
    private List<Product> LatestArrivals = new();
    private List<Product> Slides = new();
    private List<Product> RandomSneakers = new();

    protected override void OnInitialized()
    {
        var allActive = DbContext.Products.Include(p => p.Variants);

        // NOTE: no real sales/order data exists yet (checkout doesn't persist orders —
        // see ARCHITECTURE.md's mock-checkout plan and SCHEMA.md's still-unbuilt Order
        // model). Until that exists, "Bestsellers" is a placeholder — just the most
        // recently added products. Swap this for a real sales-based query once Order
        // tracking is built.
        Bestsellers = allActive.OrderByDescending(p => p.Id).Take(4).ToList();

        LatestArrivals = allActive.OrderByDescending(p => p.Id).Skip(4).Take(4).ToList();

        Slides = allActive.Where(p => p.Category == ProductCategory.Slides).Take(4).ToList();

        // Randomize client-side since SQLite doesn't have a clean EF-translatable random order.
        RandomSneakers = allActive.Where(p => p.Category == ProductCategory.Sneakers)
            .ToList()
            .OrderBy(_ => Guid.NewGuid())
            .Take(4)
            .ToList();
    }
}
