@code {
    private const string DefaultTab = "profile";
    private readonly Dictionary<string, string> Tabs = new()
    {
        ["profile"] = "Profile",
        ["address"] = "Address",
        ["security"] = "Security",
        ["orders"] = "Orders"
    };

    private ApplicationUser? CurrentUser;
    private string ActiveTab = DefaultTab;
    private string DisplayName = "Customer";
    private string Email = string.Empty;
    private string Initials = "C";
    private string? MemberSinceText;
    private string SignInMethod = "Email";
    private bool HasPassword;
    private bool IsAdmin;
    private string? AlertMessage;
    private string AlertType = "success";
    private CancellationTokenSource? AlertCancellationTokenSource;
    private bool IsSavingProfile;
    private bool IsSavingAddress;
    private bool IsSavingPassword;
    private bool IsSettingPassword;
    private bool IsDeletingAccount;
    private bool ShowCurrentPassword;
    private bool ShowNewPassword;
    private bool ShowConfirmPassword;
    private bool ShowSetPassword;
    private bool ShowSetConfirmPassword;

    private ProfileFormModel ProfileModel { get; set; } = new();
    private AddressFormModel AddressModel { get; set; } = new();
    private PasswordChangeFormModel PasswordChangeModel { get; set; } = new();
    private SetPasswordFormModel SetPasswordModel { get; set; } = new();
    private DeleteAccountFormModel DeleteAccountModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadUserAsync();
        SyncTabFromQuery();
    }

    private void SyncTabFromQuery()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var tabValue = query.TryGetValue("tab", out var tab) ? tab.ToString() : DefaultTab;
        ActiveTab = Tabs.Any(item => item.Key == tabValue) ? tabValue : DefaultTab;

        var statusValue = query.TryGetValue("status", out var status) ? status.ToString() : null;
        if (!string.IsNullOrWhiteSpace(statusValue))
        {
            var statusMessage = GetStatusMessage(statusValue);
            if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                AlertType = statusValue is "profile_saved" or "address_saved" or "password_changed" or "password_set" or "account_deleted" ? "success" : "danger";
                AlertMessage = statusMessage;
                return;
            }
        }

        AlertMessage = null;
    }

    private async Task LoadUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser = await UserManager.GetUserAsync(authState.User);
        if (CurrentUser is null)
        {
            return;
        }

        DisplayName = !string.IsNullOrWhiteSpace(CurrentUser.FullName) ? CurrentUser.FullName : CurrentUser.Email ?? "Customer";
        Email = CurrentUser.Email ?? string.Empty;
        Initials = GetInitials(DisplayName);
        HasPassword = await UserManager.HasPasswordAsync(CurrentUser);
        var logins = await UserManager.GetLoginsAsync(CurrentUser);
        SignInMethod = logins.Any(login => string.Equals(login.LoginProvider, "Google", StringComparison.OrdinalIgnoreCase)) ? "Google" : "Email";
        IsAdmin = authState.User.IsInRole("Admin");

        ProfileModel = new ProfileFormModel
        {
            FullName = CurrentUser.FullName ?? string.Empty,
            PhoneNumber = CurrentUser.PhoneNumber ?? string.Empty
        };

        AddressModel = new AddressFormModel
        {
            AddressLine1 = CurrentUser.AddressLine1 ?? string.Empty,
            AddressLine2 = CurrentUser.AddressLine2 ?? string.Empty,
            City = CurrentUser.City ?? string.Empty,
            State = CurrentUser.State ?? string.Empty,
            PostalCode = CurrentUser.PostalCode ?? string.Empty,
            Country = string.IsNullOrWhiteSpace(CurrentUser.Country) ? "Nigeria" : CurrentUser.Country
        };

        MemberSinceText = null;
    }

    private void DismissAlert()
    {
        AlertCancellationTokenSource?.Cancel();
        AlertMessage = null;
    }

    private async Task ShowStatusAlert(string message, string type = "success")
    {
        AlertCancellationTokenSource?.Cancel();
        AlertCancellationTokenSource = new CancellationTokenSource();

        AlertMessage = message;
        AlertType = type;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), AlertCancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        AlertMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string GetInitials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0)
        {
            return "C";
        }

        if (words.Length == 1)
        {
            return words[0].Substring(0, 1).ToUpperInvariant();
        }

        return string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    private void GoToTab(string tab)
    {
        var target = Tabs.Any(item => item.Key == tab) ? tab : DefaultTab;
        ActiveTab = target;
        NavigationManager.NavigateTo($"/account?tab={target}");
    }

    private static string GetStatusMessage(string statusCode)
    {
        return statusCode switch
        {
            "profile_saved" => "Profile updated successfully.",
            "address_saved" => "Address saved successfully.",
            "password_changed" => "Password changed successfully.",
            "password_set" => "Password set successfully.",
            "account_deleted" => "Your account has been deleted.",
            "profile_invalid" => "Please enter a valid name.",
            "phone_invalid" => "Please enter a valid phone number.",
            "address_incomplete" => "Please provide address line 1, city, and state.",
            "passwords_do_not_match" => "Passwords do not match.",
            "bad_password" => "The current password is incorrect.",
            "delete_confirm_required" => "Type DELETE to confirm account deletion.",
            "admin_protected" => "Admin accounts cannot be deleted.",
            "password_set_failed" => "We could not set the password. Please try again.",
            "delete_failed" => "We could not delete the account. Please try again.",
            _ => "Something went wrong. Please try again."
        };
    }

    private async Task SaveProfileAsync()
    {
        if (CurrentUser is null)
        {
            return;
        }

        IsSavingProfile = true;
        try
        {
            CurrentUser.FullName = ProfileModel.FullName.Trim();
            CurrentUser.PhoneNumber = string.IsNullOrWhiteSpace(ProfileModel.PhoneNumber) ? null : ProfileModel.PhoneNumber.Trim();

            var result = await UserManager.UpdateAsync(CurrentUser);
            if (!result.Succeeded)
            {
                await ShowStatusAlert("We could not save your profile. Please try again.", "danger");
                return;
            }

            DisplayName = string.IsNullOrWhiteSpace(CurrentUser.FullName) ? Email : CurrentUser.FullName;
            Initials = GetInitials(DisplayName);
            await ShowStatusAlert("Profile updated successfully.", "success");
            NavigationManager.NavigateTo($"/account?tab=profile&status=profile_saved");
        }
        finally
        {
            IsSavingProfile = false;
        }
    }

    private async Task SaveAddressAsync()
    {
        if (CurrentUser is null)
        {
            return;
        }

        IsSavingAddress = true;
        try
        {
            CurrentUser.AddressLine1 = string.IsNullOrWhiteSpace(AddressModel.AddressLine1) ? null : AddressModel.AddressLine1.Trim();
            CurrentUser.AddressLine2 = string.IsNullOrWhiteSpace(AddressModel.AddressLine2) ? null : AddressModel.AddressLine2.Trim();
            CurrentUser.City = string.IsNullOrWhiteSpace(AddressModel.City) ? null : AddressModel.City.Trim();
            CurrentUser.State = string.IsNullOrWhiteSpace(AddressModel.State) ? null : AddressModel.State.Trim();
            CurrentUser.PostalCode = string.IsNullOrWhiteSpace(AddressModel.PostalCode) ? null : AddressModel.PostalCode.Trim();
            CurrentUser.Country = string.IsNullOrWhiteSpace(AddressModel.Country) ? "Nigeria" : AddressModel.Country.Trim();

            var result = await UserManager.UpdateAsync(CurrentUser);
            if (!result.Succeeded)
            {
                await ShowStatusAlert("We could not save your address. Please try again.", "danger");
                return;
            }

            await ShowStatusAlert("Address saved successfully.", "success");
            NavigationManager.NavigateTo($"/account?tab=address&status=address_saved");
        }
        finally
        {
            IsSavingAddress = false;
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        if (CurrentUser is null)
        {
            return;
        }

        IsSavingPassword = true;
        try
        {
            var result = await UserManager.ChangePasswordAsync(CurrentUser, PasswordChangeModel.CurrentPassword, PasswordChangeModel.NewPassword);
            if (!result.Succeeded)
            {
                await ShowStatusAlert("The current password is incorrect or the new password is invalid.", "danger");
                return;
            }

            await UserManager.UpdateAsync(CurrentUser);
            await ShowStatusAlert("Password changed successfully.", "success");
            NavigationManager.NavigateTo($"/account?tab=security&status=password_changed");
        }
        finally
        {
            IsSavingPassword = false;
        }
    }

    private async Task HandleSetPasswordAsync()
    {
        if (CurrentUser is null)
        {
            return;
        }

        IsSettingPassword = true;
        try
        {
            var result = await UserManager.AddPasswordAsync(CurrentUser, SetPasswordModel.NewPassword);
            if (!result.Succeeded)
            {
                await ShowStatusAlert("We could not set the password. Please check the password rules and try again.", "danger");
                return;
            }

            HasPassword = true;
            await ShowStatusAlert("Password set successfully.", "success");
            NavigationManager.NavigateTo($"/account?tab=security&status=password_set");
        }
        finally
        {
            IsSettingPassword = false;
        }
    }

    private async Task SubmitDeleteAccountAsync()
    {
        if (CurrentUser is null || IsAdmin)
        {
            return;
        }

        IsDeletingAccount = true;
        try
        {
            var result = await UserManager.DeleteAsync(CurrentUser);
            if (!result.Succeeded)
            {
                AlertType = "danger";
                AlertMessage = "We could not delete the account. Please try again.";
                return;
            }

            NavigationManager.NavigateTo("/?status=account_deleted");
        }
        finally
        {
            IsDeletingAccount = false;
        }
    }

    private void ToggleVisibility(string fieldName)
    {
        if (fieldName == nameof(PasswordChangeModel.CurrentPassword))
        {
            ShowCurrentPassword = !ShowCurrentPassword;
            return;
        }

        if (fieldName == nameof(PasswordChangeModel.NewPassword))
        {
            ShowNewPassword = !ShowNewPassword;
            return;
        }

        if (fieldName == nameof(PasswordChangeModel.ConfirmPassword))
        {
            ShowConfirmPassword = !ShowConfirmPassword;
            return;
        }

        if (fieldName == nameof(SetPasswordModel.NewPassword))
        {
            ShowSetPassword = !ShowSetPassword;
            return;
        }

        if (fieldName == nameof(SetPasswordModel.ConfirmPassword))
        {
            ShowSetConfirmPassword = !ShowSetConfirmPassword;
        }
    }

    private sealed class ProfileFormModel
    {
        [Required]
        [StringLength(100)]
        public string FullName { get; set; } = string.Empty;

        [Phone]
        [StringLength(20)]
        public string PhoneNumber { get; set; } = string.Empty;
    }

    private sealed class AddressFormModel : IValidatableObject
    {
        [StringLength(120)]
        public string AddressLine1 { get; set; } = string.Empty;

        [StringLength(120)]
        public string AddressLine2 { get; set; } = string.Empty;

        [StringLength(80)]
        public string City { get; set; } = string.Empty;

        [StringLength(80)]
        public string State { get; set; } = string.Empty;

        [StringLength(20)]
        public string PostalCode { get; set; } = string.Empty;

        [StringLength(80)]
        public string Country { get; set; } = "Nigeria";

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var fields = new[] { AddressLine1, AddressLine2, City, State, PostalCode, Country };
            var hasAnyValue = fields.Any(value => !string.IsNullOrWhiteSpace(value));
            if (!hasAnyValue)
            {
                yield break;
            }

            if (string.IsNullOrWhiteSpace(AddressLine1))
            {
                yield return new ValidationResult("Address line 1 is required.", new[] { nameof(AddressLine1) });
            }

            if (string.IsNullOrWhiteSpace(City))
            {
                yield return new ValidationResult("City is required.", new[] { nameof(City) });
            }

            if (string.IsNullOrWhiteSpace(State))
            {
                yield return new ValidationResult("State is required.", new[] { nameof(State) });
            }
        }
    }

    private sealed class PasswordChangeFormModel
    {
        [Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required]
        [StringLength(100, MinimumLength = 6)]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(NewPassword))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class SetPasswordFormModel
    {
        [Required]
        [StringLength(100, MinimumLength = 6)]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(NewPassword))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class DeleteAccountFormModel
    {
        [Required]
        public string ConfirmText { get; set; } = string.Empty;

        [Required]
        public string CurrentPassword { get; set; } = string.Empty;
    }
}
