@code {
    private int SearchVersion;
    private CancellationTokenSource? SearchCancellation;
    private bool IsLoading;
    private bool ShowFilterSheet;
    private bool SearchError;
    private int VisibleCount = 48;
    private List<Product> Results = new();
    private List<Product> NewArrivals = new();

    private string QueryText = string.Empty;
    private string? ActiveCategory;
    private Gender? ActiveGender;
    private bool InStockOnly;
    private string SortMode = "relevance";

    private List<Product> VisibleResults => Results.Take(VisibleCount).ToList();

    private List<string> CategoryOptions => Enum.GetNames<ProductCategory>()
        .Where(name => name != nameof(ProductCategory.General))
        .OrderBy(name => name)
        .ToList();

    private readonly List<string> PopularCategories = new()
    {
        nameof(ProductCategory.Sneakers),
        nameof(ProductCategory.Canvas),
        nameof(ProductCategory.Slides),
        nameof(ProductCategory.Corporate)
    };

    private bool HasSearchText => !string.IsNullOrWhiteSpace(QueryText);
    private bool HasFilterSelection => !string.IsNullOrWhiteSpace(ActiveCategory) || ActiveGender.HasValue || InStockOnly;
    private bool HasActiveFilters => HasSearchText || HasFilterSelection;

    private string SelectedGenderValue => ActiveGender?.ToString() ?? string.Empty;

    private List<(string Label, string Key)> ActiveFilters
    {
        get
        {
            var filters = new List<(string Label, string Key)>();

            if (!string.IsNullOrWhiteSpace(QueryText))
            {
                filters.Add((QueryText.Trim(), "query"));
            }

            if (!string.IsNullOrWhiteSpace(ActiveCategory))
            {
                filters.Add((ActiveCategory, "category"));
            }

            if (ActiveGender.HasValue)
            {
                filters.Add((ActiveGender.Value.ToString(), "gender"));
            }

            if (InStockOnly)
            {
                filters.Add(("In stock", "stock"));
            }

            return filters;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SyncFromQueryString();
        await LoadNewArrivalsAsync();
        await TriggerSearchAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", "document.getElementById('search-box')?.focus();");
            }
            catch
            {
            }
        }
    }

    private void SyncFromQueryString()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        QueryText = query.TryGetValue("q", out var qValue) ? qValue.ToString().Trim() : string.Empty;
        ActiveCategory = query.TryGetValue("category", out var categoryValue) && !string.IsNullOrWhiteSpace(categoryValue.ToString()) ? categoryValue.ToString() : null;

        if (query.TryGetValue("gender", out var genderValue) && Enum.TryParse<Gender>(genderValue.ToString(), true, out var gender))
        {
            ActiveGender = gender;
        }
        else
        {
            ActiveGender = null;
        }

        InStockOnly = query.TryGetValue("stock", out var stockValue) && stockValue.ToString() == "1";

        if (query.TryGetValue("sort", out var sortValue) && !string.IsNullOrWhiteSpace(sortValue.ToString()) &&
            (sortValue.ToString() == "relevance" || sortValue.ToString() == "price-low" || sortValue.ToString() == "price-high" || sortValue.ToString() == "newest"))
        {
            SortMode = sortValue.ToString();
        }
        else
        {
            SortMode = "relevance";
        }
    }

    private async Task TriggerSearchAsync()
    {
        SearchCancellation?.Cancel();
        SearchCancellation?.Dispose();
        SearchCancellation = new CancellationTokenSource();

        var requestVersion = ++SearchVersion;
        var token = SearchCancellation.Token;

        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested)
        {
            return;
        }

        await ExecuteSearchAsync(requestVersion, token);
    }

    private async Task ExecuteSearchAsync(int requestVersion, CancellationToken token)
    {
        if (!HasSearchText && !HasFilterSelection)
        {
            Results = new();
            SearchError = false;
            VisibleCount = 48;
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        IsLoading = true;
        SearchError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var query = BuildBaseQuery();
            if (HasSearchText)
            {
                var terms = SplitWords(QueryText);
                foreach (var term in terms)
                {
                    var termPattern = EscapeLikePattern(term);
                    var matchingCategories = Enum.GetValues<ProductCategory>()
                        .Where(category => category.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    var matchingGenders = Enum.GetValues<Gender>()
                        .Where(gender => gender.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    query = query.Where(p =>
                        EF.Functions.Like(p.Name, $"%{termPattern}%", "\\") ||
                        (p.Description != null && EF.Functions.Like(p.Description, $"%{termPattern}%", "\\")) ||
                        p.Variants.Any(v =>
                            (v.Sku != null && EF.Functions.Like(v.Sku, $"%{termPattern}%", "\\")) ||
                            (v.Color != null && EF.Functions.Like(v.Color, $"%{termPattern}%", "\\"))) ||
                        matchingCategories.Contains(p.Category) ||
                        matchingGenders.Contains(p.Gender));
                }
            }

            var matches = await query.AsNoTracking().ToListAsync(token);
            if (requestVersion != SearchVersion || token.IsCancellationRequested)
            {
                return;
            }

            Results = SortMatches(matches);
            VisibleCount = Math.Min(48, Results.Count);
            IsLoading = false;
            SearchError = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Search failed. QueryText='{QueryText}', ActiveCategory='{ActiveCategory}', ActiveGender='{ActiveGender}', InStockOnly={InStockOnly}, SortMode='{SortMode}', Uri='{Uri}'",
                QueryText,
                ActiveCategory,
                ActiveGender,
                InStockOnly,
                SortMode,
                NavigationManager.Uri);

            if (requestVersion == SearchVersion)
            {
                Results = new();
                VisibleCount = 48;
                IsLoading = false;
                SearchError = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private IQueryable<Product> BuildBaseQuery()
    {
        var query = DbContext.Products
            .AsNoTracking()
            .Include(p => p.Variants)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(ActiveCategory) && Enum.TryParse<ProductCategory>(ActiveCategory, true, out var category))
        {
            query = query.Where(p => p.Category == category);
        }

        if (ActiveGender.HasValue)
        {
            if (ActiveGender.Value == Gender.Unisex)
            {
                query = query.Where(p => p.Gender == Gender.Unisex);
            }
            else
            {
                query = query.Where(p => p.Gender == ActiveGender.Value || p.Gender == Gender.Unisex);
            }
        }

        if (InStockOnly)
        {
            query = query.Where(p => p.Variants.Any(v => v.Stock > 0));
        }

        return query;
    }

    private static List<string> SplitWords(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new();
        }

        return raw
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(word => !string.IsNullOrWhiteSpace(word))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string EscapeLikePattern(string value)
    {
        return value
            .Replace("\\", "\\\\")
            .Replace("%", "\\%")
            .Replace("_", "\\_");
    }

    private List<Product> SortMatches(List<Product> products)
    {
        if (SortMode == "relevance" && !HasSearchText)
        {
            return products.OrderByDescending(p => p.Id).ToList();
        }

        return SortMode switch
        {
            "price-low" => products.OrderBy(p => p.Variants.Select(v => v.Price).DefaultIfEmpty(0).Min()).ToList(),
            "price-high" => products.OrderByDescending(p => p.Variants.Select(v => v.Price).DefaultIfEmpty(0).Max()).ToList(),
            "newest" => products.OrderByDescending(p => p.Id).ToList(),
            _ => products.OrderByDescending(p => GetRelevanceScore(p, QueryText)).ThenByDescending(p => p.Id).ToList()
        };
    }

    private static int GetRelevanceScore(Product product, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return 0;
        }

        var score = 0;
        foreach (var word in SplitWords(query))
        {
            if (product.Name.Contains(word, StringComparison.OrdinalIgnoreCase))
            {
                score += 6;
            }

            if (!string.IsNullOrWhiteSpace(product.Description) && product.Description.Contains(word, StringComparison.OrdinalIgnoreCase))
            {
                score += 3;
            }

            if (product.Category.ToString().Contains(word, StringComparison.OrdinalIgnoreCase))
            {
                score += 2;
            }

            if (product.Gender.ToString().Contains(word, StringComparison.OrdinalIgnoreCase))
            {
                score += 2;
            }

            score += product.Variants.Count(v =>
                (!string.IsNullOrWhiteSpace(v.Sku) && v.Sku.Contains(word, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(v.Color) && v.Color.Contains(word, StringComparison.OrdinalIgnoreCase))) * 4;
        }

        return score;
    }

    private async Task OnQueryChanged(ChangeEventArgs args)
    {
        QueryText = args.Value?.ToString() ?? string.Empty;
        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await TriggerSearchAsync();
        }
    }

    private async Task ClearQuery()
    {
        QueryText = string.Empty;
        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private async Task UpdateQueryStringAsync()
    {
        var queryValues = new Dictionary<string, string?>();

        if (!string.IsNullOrWhiteSpace(QueryText))
        {
            queryValues["q"] = QueryText.Trim();
        }

        if (!string.IsNullOrWhiteSpace(ActiveCategory))
        {
            queryValues["category"] = ActiveCategory;
        }

        if (ActiveGender.HasValue)
        {
            queryValues["gender"] = ActiveGender.Value.ToString();
        }

        if (InStockOnly)
        {
            queryValues["stock"] = "1";
        }

        if (!string.IsNullOrWhiteSpace(SortMode) && SortMode != "relevance")
        {
            queryValues["sort"] = SortMode;
        }

        var target = QueryHelpers.AddQueryString("/search", queryValues);
        NavigationManager.NavigateTo(target, replace: true);
    }

    private async Task ToggleCategory(string category)
    {
        ActiveCategory = ActiveCategory == category ? null : category;
        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private async Task OnGenderChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        ActiveGender = string.IsNullOrWhiteSpace(value) ? null : Enum.TryParse<Gender>(value, true, out var gender) ? gender : null;
        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private async Task OnInStockChanged(ChangeEventArgs args)
    {
        InStockOnly = args.Value is bool value && value;
        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs args)
    {
        SortMode = args.Value?.ToString() ?? "relevance";
        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private async Task RemoveFilter((string Label, string Key) filter)
    {
        if (filter.Key == "query")
        {
            QueryText = string.Empty;
        }
        else if (filter.Key == "category")
        {
            ActiveCategory = null;
        }
        else if (filter.Key == "gender")
        {
            ActiveGender = null;
        }
        else if (filter.Key == "stock")
        {
            InStockOnly = false;
        }

        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private async Task ClearAllFilters()
    {
        QueryText = string.Empty;
        ActiveCategory = null;
        ActiveGender = null;
        InStockOnly = false;
        SortMode = "relevance";
        ShowFilterSheet = false;
        await UpdateQueryStringAsync();
        await TriggerSearchAsync();
    }

    private string GetResultsSummaryText(int count)
    {
        if (HasSearchText)
        {
            return $"{count} results for \"{QueryText.Trim()}\"";
        }

        if (HasFilterSelection)
        {
            var parts = new List<string>();

            if (!string.IsNullOrWhiteSpace(ActiveCategory))
            {
                parts.Add(ActiveCategory);
            }

            if (ActiveGender.HasValue)
            {
                var genderLabel = ActiveGender.Value switch
                {
                    Gender.Men => "Men",
                    Gender.Women => "Women",
                    Gender.Unisex => "Unisex",
                    _ => ActiveGender.Value.ToString()
                };

                parts.Add(genderLabel == "Men" ? "Men" : genderLabel == "Women" ? "Women" : "Unisex");
            }

            if (InStockOnly)
            {
                parts.Add("in stock only");
            }

            if (parts.Count == 0)
            {
                return $"{count} products";
            }

            return $"{count} products in {string.Join(" and ", parts)}";
        }

        return $"{count} products";
    }

    private async Task RetrySearch()
    {
        SearchError = false;
        await TriggerSearchAsync();
    }

    private async Task ShowMoreResults()
    {
        VisibleCount = Math.Min(VisibleCount + 48, Results.Count);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleFilterSheet()
    {
        ShowFilterSheet = !ShowFilterSheet;
    }

    private async Task LoadNewArrivalsAsync()
    {
        NewArrivals = await DbContext.Products
            .AsNoTracking()
            .Include(p => p.Variants)
            .OrderByDescending(p => p.Id)
            .Take(4)
            .ToListAsync();
    }
