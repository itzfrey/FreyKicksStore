@page "/search"
@rendermode InteractiveServer
@using FreyKicksStore.Components.Shared
@using FreyKicksStore.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject FreyKicksStore.Data.ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<Search> Logger

<PageTitle>Search</PageTitle>

<div class="search-shell">
    <div class="container py-4 py-lg-5">
        <div class="search-panel">
            <div class="search-input-wrap">
                <svg viewBox="0 0 24 24" class="search-input-icon" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5"></circle>
                    <path d="M16 16L21 21"></path>
                </svg>

                <input id="search-box"
                       type="text"
                       class="search-input"
                       value="@QueryText"
                       placeholder="Search Frey Kicks"
                       autocomplete="off"
                       spellcheck="false"
                       @oninput="OnQueryChanged"
                       @onkeydown="HandleKeyDown" />

                @if (!string.IsNullOrWhiteSpace(QueryText))
                {
                    <button type="button" class="search-clear" aria-label="Clear search" @onclick="ClearQuery">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 6L18 18M18 6L6 18"></path>
                        </svg>
                    </button>
                }
            </div>

            <div class="search-controls d-none d-lg-flex">
                <div class="chip-row">
                    @foreach (var category in CategoryOptions)
                    {
                        <button type="button" class="chip @(ActiveCategory == category ? "chip-active" : string.Empty)" @onclick="() => ToggleCategory(category)">
                            @category
                        </button>
                    }
                </div>

                <div class="control-row">
                    <label class="field-wrap">
                        <span>Gender</span>
                        <select class="form-select" value="@SelectedGenderValue" @onchange="OnGenderChanged">
                            <option value="">All</option>
                            <option value="Men">Men</option>
                            <option value="Women">Women</option>
                            <option value="Unisex">Unisex</option>
                        </select>
                    </label>

                    <label class="check-wrap">
                        <input type="checkbox" checked="@InStockOnly" @onchange="OnInStockChanged" />
                        <span>In stock only</span>
                    </label>

                    <label class="field-wrap small-field">
                        <span>Sort</span>
                        <select class="form-select" value="@SortMode" @onchange="OnSortChanged">
                            <option value="relevance">Relevance</option>
                            <option value="price-low">Price: low to high</option>
                            <option value="price-high">Price: high to low</option>
                            <option value="newest">Newest</option>
                        </select>
                    </label>
                </div>
            </div>

            <div class="d-lg-none search-mobile-bar">
                <button type="button" class="mobile-filter-btn" @onclick="ToggleFilterSheet">
                    Filters
                    @if (HasActiveFilters)
                    {
                        <span class="mobile-filter-count">@ActiveFilters.Count</span>
                    }
                </button>
            </div>

            @if (HasActiveFilters)
            {
                <div class="active-filter-row" aria-label="Active filters">
                    @foreach (var filter in ActiveFilters)
                    {
                        <button type="button" class="active-filter" @onclick="() => RemoveFilter(filter)">
                            <span>@filter.Label</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6L18 18M18 6L6 18"></path></svg>
                        </button>
                    }

                    <button type="button" class="clear-all" @onclick="ClearAllFilters">Clear all</button>
                </div>
            }
        </div>

        @if (IsLoading)
        {
            <div class="results-block">
                <div class="skeleton-meta"></div>
                <div class="product-grid">
                    @for (var i = 0; i < 8; i++)
                    {
                        <div class="skeleton-card">
                            <div class="skeleton-image"></div>
                            <div class="skeleton-line short"></div>
                            <div class="skeleton-line"></div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (!HasSearchText && !HasFilterSelection)
        {
            <div class="empty-state">
                <h2>Search Frey Kicks</h2>
                <div class="chip-row default-chip-row">
                    @foreach (var category in PopularCategories)
                    {
                        <button type="button" class="chip chip-soft" @onclick="() => ToggleCategory(category)">@category</button>
                    }
                </div>
                <div class="section-heading">
                    <h3>New arrivals</h3>
                </div>
            </div>

            @if (NewArrivals.Count > 0)
            {
                <div class="product-grid results-grid">
                    @foreach (var product in NewArrivals)
                    {
                        <ProductCard Product="product" />
                    }
                </div>
            }
        }
        else if (SearchError)
        {
            <div class="empty-state results-empty">
                <h2>Something went wrong searching.</h2>
                <p>Please try again.</p>
                <button type="button" class="btn btn-dark" @onclick="RetrySearch">Try again</button>
            </div>
        }
        else if (Results.Count == 0)
        {
            <div class="empty-state results-empty">
                @if (HasSearchText)
                {
                    <h2>No results for "@QueryText"</h2>
                    <p>Try checking your spelling or use fewer words.</p>
                }
                else
                {
                    <h2>No products found</h2>
                    <p>Try removing a filter.</p>
                }

                @if (HasFilterSelection || HasSearchText)
                {
                    <button type="button" class="btn btn-dark" @onclick="ClearAllFilters">Clear filters</button>
                }
            </div>

            @if (NewArrivals.Count > 0)
            {
                <div class="section-heading mt-4">
                    <h3>New arrivals</h3>
                </div>
                <div class="product-grid results-grid">
                    @foreach (var product in NewArrivals)
                    {
                        <ProductCard Product="product" />
                    }
                </div>
            }
        }
        else
        {
            <div class="results-summary" aria-live="polite">
                <span>@GetResultsSummaryText(Results.Count)</span>
            </div>

            <div class="results-count">
                Showing @Math.Min(VisibleCount, Results.Count) of @Results.Count
            </div>

            <div class="product-grid results-grid">
                @foreach (var product in VisibleResults)
                {
                    <ProductCard Product="product" />
                }
            </div>

            @if (Results.Count > VisibleResults.Count)
            {
                <div class="show-more-wrap">
                    <button type="button" class="btn btn-outline-dark" @onclick="ShowMoreResults">Show more</button>
                </div>
            }
        }
    </div>
</div>

@if (ShowFilterSheet)
{
    <div class="sheet-backdrop" @onclick="ToggleFilterSheet"></div>
    <div class="bottom-sheet">
        <div class="sheet-header">
            <h4>Filters</h4>
            <button type="button" class="sheet-close" @onclick="ToggleFilterSheet" aria-label="Close filters">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6L18 18M18 6L6 18"></path></svg>
            </button>
        </div>

        <div class="sheet-body">
            <div class="mb-3">
                <label class="sheet-label">Gender</label>
                <select class="form-select" value="@SelectedGenderValue" @onchange="OnGenderChanged">
                    <option value="">All</option>
                    <option value="Men">Men</option>
                    <option value="Women">Women</option>
                    <option value="Unisex">Unisex</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="sheet-label">Category</label>
                <div class="sheet-chip-list">
                    @foreach (var category in CategoryOptions)
                    {
                        <button type="button" class="chip @(ActiveCategory == category ? "chip-active" : string.Empty)" @onclick="() => ToggleCategory(category)">
                            @category
                        </button>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="sheet-label">Sort</label>
                <select class="form-select" value="@SortMode" @onchange="OnSortChanged">
                    <option value="relevance">Relevance</option>
                    <option value="price-low">Price: low to high</option>
                    <option value="price-high">Price: high to low</option>
                    <option value="newest">Newest</option>
                </select>
            </div>

            <label class="check-wrap sheet-check">
                <input type="checkbox" checked="@InStockOnly" @onchange="OnInStockChanged" />
                <span>In stock only</span>
            </label>
        </div>

        <div class="sheet-footer">
            <button type="button" class="btn btn-outline-dark flex-fill" @onclick="ClearAllFilters">Clear all</button>
            <button type="button" class="btn btn-dark flex-fill" @onclick="ToggleFilterSheet">Apply</button>
        </div>
    </div>
}

