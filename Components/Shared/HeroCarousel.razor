@using FreyKicksStore.Models

@if (Slides.Count > 0)
{
    <section class="hero-carousel" data-hero-carousel role="region" aria-roledescription="carousel" aria-label="Featured products">
        @for (var i = 0; i < Slides.Count; i++)
        {
            var slide = Slides[i];
            var isActive = i == 0;

            <article class="hero-slide @(isActive ? "is-active" : string.Empty)" data-index="@i" aria-hidden="@(isActive ? "false" : "true")">
                <img src="@slide.ImageUrl"
                     alt="@slide.Category"
                     loading="eager"
                     decoding="async"
                     fetchpriority="@(i == 0 ? "high" : "auto")"
                     class="hero-image" />

                <div class="hero-overlay"></div>

                <div class="hero-content">
                    <span class="hero-kicker">@slide.Eyebrow</span>
                    <h1>@slide.Title</h1>
                    <p>@slide.Subtitle</p>

                    <div class="hero-actions">
                        <a class="hero-button hero-button-primary" href="@BuildCategoryUrl(slide.Category)" aria-label="Shop @slide.Category">
                            Shop @slide.Category
                        </a>
                        <a class="hero-button hero-button-secondary" href="/shop" aria-label="View all products">
                            View all
                        </a>
                    </div>
                </div>
            </article>
        }
    </section>
}

<style>
    .hero-carousel {
        position: relative;
        width: 100%;
        max-width: 100%;
        margin: 0;
        border-radius: 0;
        overflow: hidden;
        height: clamp(420px, 70vh, 720px);
        background: #e9ecef;
        touch-action: pan-y;
        isolation: isolate;
    }

    .hero-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        z-index: 0;
        pointer-events: none;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        transform: scale(1.06);
    }

    .hero-slide.is-active {
        opacity: 1;
        z-index: 1;
        pointer-events: auto;
        transform: scale(1);
    }

    .hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform 4s ease, opacity 0.6s ease;
        transform: scale(1.06);
    }

    .hero-slide.is-active .hero-image {
        transform: scale(1);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(90deg, rgba(17, 17, 17, 0.28) 0%, rgba(17, 17, 17, 0.08) 42%, rgba(17, 17, 17, 0.18) 100%);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        height: 100%;
        max-width: 680px;
        margin: 0 auto;
        padding: 48px 20px 56px;
        color: #ffffff;
        text-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    }

    .hero-kicker,
    .hero-content h1,
    .hero-content p,
    .hero-actions {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.42s ease, transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hero-slide.is-active .hero-kicker,
    .hero-slide.is-active .hero-content h1,
    .hero-slide.is-active .hero-content p,
    .hero-slide.is-active .hero-actions {
        opacity: 1;
        transform: translateY(0);
    }

    .hero-slide.is-active .hero-kicker { transition-delay: 0ms; }
    .hero-slide.is-active .hero-content h1 { transition-delay: 80ms; }
    .hero-slide.is-active .hero-content p { transition-delay: 160ms; }
    .hero-slide.is-active .hero-actions { transition-delay: 240ms; }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.10);
        border: 1px solid rgba(255, 255, 255, 0.18);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        margin-bottom: 18px;
        color: #ffffff;
    }

    .hero-content h1 {
        margin: 0;
        font-size: clamp(2.8rem, 5vw, 5rem);
        line-height: 0.97;
        letter-spacing: -0.06em;
        color: #ffffff;
    }

    .hero-content p {
        margin: 18px 0 0;
        max-width: 580px;
        font-size: 1.08rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.82);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-top: 28px;
    }

    .hero-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0.8rem 1.4rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        line-height: 1.2;
        transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    }

    .hero-button:hover,
    .hero-button:focus-visible {
        transform: translateY(-1px);
        text-decoration: none;
        outline: none;
    }

    .hero-button-primary {
        background: #ffffff;
        color: #111111;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    }

    .hero-button-primary:hover,
    .hero-button-primary:focus-visible {
        background: #f5f5f5;
        color: #111111;
    }

    .hero-button-secondary {
        background: rgba(17, 17, 17, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.7);
        color: #ffffff;
    }

    .hero-button-secondary:hover,
    .hero-button-secondary:focus-visible {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.9);
        color: #ffffff;
    }

    @@media (max-width: 767.98px) {
        .hero-carousel {
            height: 62svh;
            height: 62vh;
        }

        .hero-overlay {
            background: linear-gradient(180deg, rgba(17, 17, 17, 0.18) 0%, rgba(17, 17, 17, 0.52) 100%);
        }

        .hero-content {
            padding: 32px 18px 64px;
        }

        .hero-actions {
            margin-top: 22px;
            width: 100%;
        }

        .hero-button {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .hero-slide,
        .hero-image,
        .hero-kicker,
        .hero-content h1,
        .hero-content p,
        .hero-actions,
        .hero-button {
            transition: none !important;
            animation: none !important;
            transform: none !important;
        }
    }
</style>

@code {
    [Parameter]
    public List<HeroSlideItem> Slides { get; set; } = new();

    private static string BuildCategoryUrl(string category)
    {
        return $"/shop?category={Uri.EscapeDataString(category)}";
    }
}
