@inject IConfiguration Configuration

<footer class="site-footer">
    <div class="site-footer__top">
        <div class="site-footer__brand-block">
            <div class="site-footer__brand">Frey Kicks</div>
            <div class="site-footer__links">
                <a href="/shop" class="site-footer__link">Shop</a>
                <a href="/contact" class="site-footer__link">Contact Us</a>
                <a href="/cart" class="site-footer__link">Cart</a>
            </div>
        </div>

        <div class="site-footer__socials" aria-label="Frey Kicks social links">
            @if (!string.IsNullOrWhiteSpace(WhatsAppNumber))
            {
                <a class="site-footer__social" href="@BuildWhatsAppUrl("Hello Frey Kicks, I have a question.")" target="_blank" rel="noopener noreferrer" aria-label="Frey Kicks on WhatsApp">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.5 12.1c0 4.5-3.7 8.1-8.2 8.1a8.4 8.4 0 0 1-4-1.1L4 20.5l1.4-4.1A8 8 0 0 1 3.7 12c0-4.5 3.7-8.1 8.2-8.1s8.1 3.6 8.1 8.1Zm-8.2-5.6c-2.4 0-4.3 1.8-4.3 4.1 0 .9.3 1.8.8 2.5l.2.3-.5 1.5 1.5-.5.3.2c.7.4 1.5.6 2.4.6 2.4 0 4.3-1.8 4.3-4.1 0-2.3-1.8-4.1-4.3-4.1Zm2.6 5.3c-.1-.1-.2-.2-.5-.2-.2 0-.5.1-.8.3l-.2.2c-.1.1-.2.1-.3 0-.2-.1-.8-.4-1.4-.9-.5-.5-.8-1-1-1.3-.1-.3 0-.5.1-.7l.1-.2c.1-.1.1-.2 0-.3l-.3-.7c-.1-.1-.2-.1-.3-.2h-.3c-.1 0-.3.1-.4.2-.2.2-.6.6-.6 1.4 0 .8.6 1.6.8 2.1.2.4 1.5 2.3 3.5 3.1.5.2.9.4 1.2.5.5.2.9.2 1.2.1.4-.1 1.2-.5 1.3-1 .1-.5.1-.9 0-1.1l-.2-.3Z" fill="currentColor"/>
                    </svg>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(InstagramHandle))
            {
                <a class="site-footer__social" href="@InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Frey Kicks on Instagram">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3.5" y="3.5" width="17" height="17" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
                        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
                        <circle cx="17.2" cy="6.8" r="1" fill="currentColor"/>
                    </svg>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(EmailAddress))
            {
                <a class="site-footer__social" href="mailto:@EmailAddress" aria-label="Email Frey Kicks">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                        <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(PhoneNumber))
            {
                <a class="site-footer__social" href="tel:@PhoneNumber" aria-label="Call Frey Kicks">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 4.5h3l1.2 4.4-2 2.1a15.5 15.5 0 0 0 9.8 9.8l2.1-2 4.4 1.2v3a2 2 0 0 1-2 2A17.5 17.5 0 0 1 5 6.5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(FacebookUrl))
            {
                <a class="site-footer__social" href="@FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Frey Kicks on Facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14.2 8.5h2V5.1h-2.1c-2.9 0-4.1 1.8-4.1 4.1V11H7.8v3.4h2.2v6h3.5v-6h2.6l.5-3.4h-3.1V9.8c0-.9.4-1.3 1.7-1.3Z" fill="currentColor"/>
                    </svg>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(TikTokUrl))
            {
                <a class="site-footer__social" href="@TikTokUrl" target="_blank" rel="noopener noreferrer" aria-label="Frey Kicks on TikTok">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14.4 4.5c.7 1.2 1.8 2.1 3.2 2.6v2.6c-1.2 0-2.4-.3-3.4-.9v5.1c0 3.8-3.5 6.2-6.6 4.7-2.2-1.1-3.2-3.8-2.3-6.1.8-2.3 3.3-3.8 5.7-3.2v2.8c-.9-.3-1.8 0-2.4.6-.6.6-.7 1.7-.2 2.4.7 1.1 2.3 1.4 3.4.8 1.1-.6 1.8-1.8 1.8-3.1V4.5h1.8Z" fill="currentColor"/>
                    </svg>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(XUrl))
            {
                <a class="site-footer__social" href="@XUrl" target="_blank" rel="noopener noreferrer" aria-label="Frey Kicks on X">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18.9 3h3.2l-7 8 8.2 10h-6.2l-4.8-6.2-5.5 6.2H3.4l7.4-8.5L3 3h6.4l4.4 5.8L18.9 3Zm-1 15.5h1.8L8.3 4.4H6.4l11.5 14.1Z" fill="currentColor"/>
                    </svg>
                </a>
            }
        </div>
    </div>

    <div class="site-footer__copyright">
        <small>&copy; @DateTime.Now.Year Frey Kicks. All rights reserved.</small>
    </div>
</footer>

<style>
    .site-footer {
        border-top: 1px solid rgba(17, 17, 17, 0.08);
        background: #f8f9fa;
        padding: 2rem 1rem 2.5rem;
        color: #6b7280;
    }

    .site-footer__top {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .site-footer__brand-block {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .site-footer__brand {
        font-size: 1.1rem;
        font-weight: 800;
        color: #111111;
    }

    .site-footer__links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .site-footer__link {
        color: #4b5563;
        text-decoration: none;
        font-weight: 600;
    }

    .site-footer__link:hover,
    .site-footer__link:focus-visible {
        color: #111111;
        text-decoration: none;
        outline: none;
    }

    .site-footer__socials {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    .site-footer__social {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid rgba(17, 17, 17, 0.18);
        border-radius: 50%;
        background: #ffffff;
        color: #111111;
        transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .site-footer__social svg {
        width: 16px;
        height: 16px;
        display: block;
    }

    .site-footer__social:hover,
    .site-footer__social:focus-visible {
        background: #111111;
        border-color: #111111;
        color: #ffffff;
        transform: translateY(-1px);
        text-decoration: none;
        outline: none;
    }

    .site-footer__copyright {
        max-width: 1280px;
        margin: 1.4rem auto 0;
        text-align: center;
        color: #6b7280;
    }

    @@media (max-width: 767.98px) {
        .site-footer {
            padding-top: 1.75rem;
            padding-bottom: 2rem;
        }

        .site-footer__top {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .site-footer__links,
        .site-footer__socials {
            justify-content: center;
        }
    }
</style>

@code {
    private string? WhatsAppNumber => NormalizeWhatsAppNumber(Configuration["Contact:WhatsAppNumber"]);
    private string? EmailAddress => Configuration["Contact:Email"]?.Trim();
    private string? PhoneNumber => Configuration["Contact:Phone"]?.Trim();
    private string? InstagramHandle => NormalizeInstagramHandle(Configuration["Contact:Instagram"]);
    private string? FacebookUrl => Configuration["Contact:Facebook"]?.Trim();
    private string? TikTokUrl => Configuration["Contact:TikTok"]?.Trim();
    private string? XUrl => Configuration["Contact:X"]?.Trim();
    private string InstagramUrl => string.IsNullOrWhiteSpace(InstagramHandle) ? string.Empty : $"https://www.instagram.com/{InstagramHandle}/";

    private static string? NormalizeWhatsAppNumber(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(digits))
        {
            return null;
        }

        return digits.TrimStart('0');
    }

    private static string? NormalizeInstagramHandle(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var trimmed = value.Trim();
        trimmed = trimmed.Trim('@');
        trimmed = trimmed.Trim();

        if (trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
        {
            if (Uri.TryCreate(trimmed, UriKind.Absolute, out var uri))
            {
                var host = uri.Host.Replace("www.", string.Empty, StringComparison.OrdinalIgnoreCase);
                if (host.Equals("instagram.com", StringComparison.OrdinalIgnoreCase))
                {
                    var path = uri.AbsolutePath.Trim('/');
                    if (!string.IsNullOrWhiteSpace(path) && path != "instagram.com")
                    {
                        trimmed = path;
                    }
                }
            }
        }

        if (trimmed.StartsWith("instagram.com/", StringComparison.OrdinalIgnoreCase))
        {
            trimmed = trimmed["instagram.com/".Length..].Trim('/');
        }

        trimmed = trimmed.Trim('/').Trim();
        trimmed = trimmed.Trim('@');

        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return null;
        }

        return trimmed;
    }

    private string BuildWhatsAppUrl(string text)
    {
        if (string.IsNullOrWhiteSpace(WhatsAppNumber))
        {
            return string.Empty;
        }

        return $"https://wa.me/{WhatsAppNumber}?text={Uri.EscapeDataString(text)}";
    }
}
