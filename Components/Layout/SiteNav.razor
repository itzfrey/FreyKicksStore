@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

<nav class="navbar navbar-expand-lg navbar-light bg-white" style="position:relative;">
    <div class="container-fluid d-flex align-items-center" style="position:relative;">
        <button class="btn d-lg-none border-0" type="button" @onclick="ToggleMobileMenu" aria-label="Open menu">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

        <!-- Logo: normal flow, left-aligned -->
        <a class="site-logo navbar-brand m-0 logo-centered" href="/">
            <img src="/images/products/Frey_kicks_logo.png" alt="Frey Kicks" style="height:50px;" class="d-none d-lg-inline-block" />
            <span class="d-lg-none lh-1 d-inline-block">
                Frey<br />Kicks
            </span>
        </a>

        <!-- Nav links: absolutely centered in the full bar -->
        <div class="d-none d-lg-flex align-items-center position-absolute" style="left:50%; top:50%; transform:translate(-50%, -50%);">
            <ul class="navbar-nav me-3">
                <li class="nav-item position-relative">
                    <a class="nav-link" href="#" @onclick="ToggleMenDesktop" @onclick:preventDefault>Men ▾</a>
                    @if (menDesktopOpen)
                    {
                        <ul class="dropdown-menu show" style="position:absolute; top:100%; left:0;">
                            <li><a class="dropdown-item" href="/shop?gender=Men&category=Sneakers">Sneakers</a></li>
                            <li><a class="dropdown-item" href="/shop?gender=Men&category=Canvas">Canvas</a></li>
                            <li><a class="dropdown-item" href="/shop?gender=Men&category=Corporate">Corporate</a></li>
                            <li><a class="dropdown-item" href="/shop?gender=Men&category=Slides">Slides</a></li>
                        </ul>
                    }
                </li>
                <li class="nav-item position-relative">
                    <a class="nav-link" href="#" @onclick="ToggleWomenDesktop" @onclick:preventDefault>Women ▾</a>
                    @if (womenDesktopOpen)
                    {
                        <ul class="dropdown-menu show" style="position:absolute; top:100%; left:0;">
                            <li><a class="dropdown-item" href="/shop?gender=Women&category=Sneakers">Sneakers</a></li>
                            <li><a class="dropdown-item" href="/shop?gender=Women&category=Canvas">Canvas</a></li>
                            <li><a class="dropdown-item" href="/shop?gender=Women&category=Loafers">Loafers</a></li>
                            <li><a class="dropdown-item" href="/shop?gender=Women&category=Slides">Slides</a></li>
                        </ul>
                    }
                </li>
                <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
            </ul>
        </div>

        <div class="d-flex align-items-center ms-auto">
            <!-- icons unchanged -->
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/account/logout" class="m-0 me-3">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link p-0 border-0" aria-label="Account">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-link p-0 me-3" href="/account/login-ui" aria-label="Login">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </a>
                </NotAuthorized>
            </AuthorizeView>

            <a class="btn btn-link p-0 me-3" href="/search" aria-label="Search">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </a>
            <a class="btn btn-link p-0" href="/cart" aria-label="Cart">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18l-1.5 12a2 2 0 0 1-2 1.7H6.5a2 2 0 0 1-2-1.7L3 7Z"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg>
            </a>
        </div>
    </div>
</nav>

@if (mobileMenuOpen)
{
    <div class="d-lg-none" style="position:fixed; inset:0; background:#fff; z-index:1050; overflow-y:auto;">
        @if (mobileLevel == MobileLevel.Top)
        {
            <div class="p-3">
                <button class="btn p-0 border-0 mb-4" @onclick="ToggleMobileMenu" aria-label="Close menu">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>

                <ul class="list-unstyled">
                    <li class="border-bottom">
                        <a class="d-flex justify-content-between align-items-center py-3 text-dark text-decoration-none" href="/" @onclick="ToggleMobileMenu">
                            <span class="fs-5">Home</span>
                        </a>
                    </li>
                    <li class="border-bottom" style="cursor:pointer;" @onclick="() => GoToMobileLevel(MobileLevel.Men)">
                        <div class="d-flex justify-content-between align-items-center py-3">
                            <span class="fs-5">Men</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </div>
                    </li>
                    <li class="border-bottom" style="cursor:pointer;" @onclick="() => GoToMobileLevel(MobileLevel.Women)">
                        <div class="d-flex justify-content-between align-items-center py-3">
                            <span class="fs-5">Women</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </div>
                    </li>
                    <li class="border-bottom">
                        <a class="d-flex justify-content-between align-items-center py-3 text-dark text-decoration-none" href="/contact" @onclick="ToggleMobileMenu">
                            <span class="fs-5">Contact Us</span>
                        </a>
                    </li>
                </ul>

                <div class="position-fixed bottom-0 start-0 w-100 p-3 border-top bg-white">
                    <AuthorizeView>
                        <Authorized>
                            <form method="post" action="/account/logout" class="m-0">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-link p-0 d-flex align-items-center text-dark text-decoration-none">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <span class="text-uppercase small">Logout</span>
                                </button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <a class="d-flex align-items-center text-dark text-decoration-none" href="/account/login-ui" @onclick="ToggleMobileMenu">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                <span class="text-uppercase small">Login</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        }
        else if (mobileLevel == MobileLevel.Men)
        {
            <div class="p-3">
                <button class="btn btn-link p-0 border-0 mb-4 d-flex align-items-center text-dark text-decoration-none" @onclick="BackToTop">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="15 18 9 12 15 6"/></svg>
                    <span class="fs-5">Men</span>
                </button>
                <ul class="list-unstyled">
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Men&category=Sneakers" @onclick="ToggleMobileMenu">Sneakers</a></li>
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Men&category=Canvas" @onclick="ToggleMobileMenu">Canvas</a></li>
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Men&category=Corporate" @onclick="ToggleMobileMenu">Corporate</a></li>
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Men&category=Slides" @onclick="ToggleMobileMenu">Slides</a></li>
                </ul>
            </div>
        }
        else if (mobileLevel == MobileLevel.Women)
        {
            <div class="p-3">
                <button class="btn btn-link p-0 border-0 mb-4 d-flex align-items-center text-dark text-decoration-none" @onclick="BackToTop">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="15 18 9 12 15 6"/></svg>
                    <span class="fs-5">Women</span>
                </button>
                <ul class="list-unstyled">
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Women&category=Sneakers" @onclick="ToggleMobileMenu">Sneakers</a></li>
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Women&category=Canvas" @onclick="ToggleMobileMenu">Canvas</a></li>
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Women&category=Loafers" @onclick="ToggleMobileMenu">Loafers</a></li>
                    <li class="border-bottom"><a class="d-block py-3 text-dark text-decoration-none fs-6" href="/shop?gender=Women&category=Slides" @onclick="ToggleMobileMenu">Slides</a></li>
                </ul>
            </div>
        }
    </div>
}

@code {
    private enum MobileLevel { Top, Men, Women }

    private bool mobileMenuOpen;
    private MobileLevel mobileLevel = MobileLevel.Top;
    private bool menDesktopOpen;
    private bool womenDesktopOpen;

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
        if (!mobileMenuOpen) mobileLevel = MobileLevel.Top;
    }

    private void GoToMobileLevel(MobileLevel level) => mobileLevel = level;
    private void BackToTop() => mobileLevel = MobileLevel.Top;

    private void ToggleMenDesktop()
    {
        menDesktopOpen = !menDesktopOpen;
        womenDesktopOpen = false;
    }

    private void ToggleWomenDesktop()
    {
        womenDesktopOpen = !womenDesktopOpen;
        menDesktopOpen = false;
    }
}
