@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<div class="d-flex flex-column min-vh-100">
    <SiteNav />

    <main class="container mt-4 flex-grow-1">
        @Body
    </main>

    <SiteFooter />
</div>

@if (!string.IsNullOrWhiteSpace(WhatsAppNumber))
{
    <a class="wa-fab @(IsCartPage ? "wa-fab--cart" : string.Empty)"
       href="@BuildWhatsAppUrl("Hello Frey Kicks, I have a question.")"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 12.1c0 4.5-3.7 8.1-8.2 8.1a8.4 8.4 0 0 1-4-1.1L4 20.5l1.4-4.1A8 8 0 0 1 3.7 12c0-4.5 3.7-8.1 8.2-8.1s8.1 3.6 8.1 8.1Zm-8.2-5.6c-2.4 0-4.3 1.8-4.3 4.1 0 .9.3 1.8.8 2.5l.2.3-.5 1.5 1.5-.5.3.2c.7.4 1.5.6 2.4.6 2.4 0 4.3-1.8 4.3-4.1 0-2.3-1.8-4.1-4.3-4.1Zm2.6 5.3c-.1-.1-.2-.2-.5-.2-.2 0-.5.1-.8.3l-.2.2c-.1.1-.2.1-.3 0-.2-.1-.8-.4-1.4-.9-.5-.5-.8-1-1-1.3-.1-.3 0-.5.1-.7l.1-.2c.1-.1.1-.2 0-.3l-.3-.7c-.1-.1-.2-.1-.3-.2h-.3c-.1 0-.3.1-.4.2-.2.2-.6.6-.6 1.4 0 .8.6 1.6.8 2.1.2.4 1.5 2.3 3.5 3.1.5.2.9.4 1.2.5.5.2.9.2 1.2.1.4-.1 1.2-.5 1.3-1 .1-.5.1-.9 0-1.1l-.2-.3Z" fill="currentColor"/>
        </svg>
    </a>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .wa-fab {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 1040;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(180deg, #22c55e 0%, #16a34a 100%);
        color: #ffffff;
        box-shadow: 0 18px 34px rgba(34, 197, 94, 0.35);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .wa-fab:hover,
    .wa-fab:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 22px 38px rgba(34, 197, 94, 0.42);
        color: #ffffff;
        text-decoration: none;
        outline: none;
    }

    .wa-fab svg {
        width: 24px;
        height: 24px;
        display: block;
    }

    .wa-fab--cart {
        bottom: 92px;
    }

    @@media (max-width: 767.98px) {
        .wa-fab {
            right: 18px;
            bottom: 18px;
        }

        .wa-fab--cart {
            bottom: 96px;
        }
    }
</style>

@code {
    private bool IsCartPage => NavigationManager.Uri.Contains("/cart", StringComparison.OrdinalIgnoreCase);

    private string? WhatsAppNumber => NormalizeWhatsAppNumber(Configuration["Contact:WhatsAppNumber"]);

    private static string? NormalizeWhatsAppNumber(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var digits = new string(value.Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? null : digits.TrimStart('0');
    }

    private string BuildWhatsAppUrl(string text)
    {
        if (string.IsNullOrWhiteSpace(WhatsAppNumber))
        {
            return string.Empty;
        }

        return $"https://wa.me/{WhatsAppNumber}?text={Uri.EscapeDataString(text)}";
    }
}
